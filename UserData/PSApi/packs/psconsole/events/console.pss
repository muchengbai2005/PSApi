# console.pss — PS 指令台逻辑 (仿 Minecraft 指令系统)
# 窗口 = ui/console.psui; / 键开关 (ui.bind_key, Events v1.16.0); 输入框回车提交 (input on_submit)。
# 日志 = 包全局环形数组 g_log (最近 60 行), 每条指令执行后 ui.rebuild 重绘日志区。
# 注意: pss 无 try/catch, 所有指令在调框架 API 前先做参数预检 (is_num/派系白名单/npc 注册表),
# 避免 PsRuntimeError 穿出回调 (那样只会进日志, 指令台无回显)。
# v0.1.1: give 支持 {} 块语法 (引号串可含空格, 逗号分隔 k=v, 值可嵌套 {} 字典);
#         分词器整体重写 (引号/花括号感知的 tokenize); 派系白名单更正为框架合法值。
# v0.2.0 (2026-10-08, 需 PSApi ≥ v2.0.2): 指令大扩展 20 条 (提案 _docs/开发向/psconsole指令扩展提案.md 全量落地) —
#   犯罪系: crime list/add/clear/clearall/evidence (clear/clearall/evidence 走新 builtin crime.clear/clear_all/evidence);
#   gunworks 系: raid maps/unlock/lock/cd/status + gw parts/repair/tank (跨包存档走新 builtin state.pget/pset/phas/pdel);
#   原版通用系: power/restock/showcase/attract/goto/bag clear (新 builtin items.inventory)/npc rep。

ui.bind_key("Slash", "psconsole:console")

var g_log = []
var LOG_KEEP = 59          # 超出 60 行时保留的最新行数
var FACTIONS = ["sec", "rev", "bm", "cartel", "ul", "ll"]
var Q = "\""               # 引号字符常量 (字符串比较用)
var g_err = ""             # 解析错误暂存 (pss 无异常, 用全局标记替代)

# ---- v0.2.0 数据表 (与各自来源同步维护) ----

