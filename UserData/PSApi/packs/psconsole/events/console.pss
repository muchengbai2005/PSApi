    FACTION_CARTEL = "cartel", FACTION_UPPER_LEVEL = "ul", FACTION_LOWER_LEVEL = "ll"}

# ============ 日志与重绘 ============

func log_line(s):
    push(g_log, s)
    if len(g_log) > 60:
        var nl = []
        for i in range(len(g_log) - LOG_KEEP, len(g_log)):
            push(nl, g_log[i])
        g_log = nl

func redraw():
    if ui.is_open("console"):
        ui.rebuild("console")

# on_build: 构建期填充日志区 (静态骨架建完后, Show 前)
func build_console():
    ui.build_begin("log_area")
    if len(g_log) == 0:
        ui.build_label("(日志空) 输入 help 查看全部指令")
    else:
        for line in g_log:
            ui.build_label(line)
    ui.build_end()

# ============ 输入入口 ============

# input on_submit 回调 {elem, value}; 框架在回调后自动清空输入框
func on_submit(a):
    run_raw(a.value)

# 「执行」按钮: 手动读输入框 + 清空 (on_submit 路径由框架清空)
func on_exec():
    var s = ui.get_value("cmd_input")
    if len(s) > 0:
        run_raw(s)
        ui.set_value("cmd_input", "")

# ============ 指令分发 ============

func run_raw(raw):
    var s = raw
    # 兼容前导 "/": "/give ..." 与 "give ..." 等价
    if len(s) > 0 and s[0] == "/":
        s = substr(s, 1, len(s))
    g_err = ""
    var parts = tokenize(s)
    if len(parts) == 0 and g_err == "":
        return
    log_line("> " + raw)
    if g_err != "":
        log_line("【错误】" + g_err)
        redraw()
        return
    dispatch(parts)
    redraw()

func dispatch(parts):
    var cmd = parts[0]
    if cmd == "help":
        cmd_help()
    elif cmd == "give":
        cmd_give(parts)
    elif cmd == "cash":
        cmd_cash(parts)
    elif cmd == "rep":
        cmd_rep(parts)
    elif cmd == "day":
        cmd_day()
    elif cmd == "npc":
        cmd_npc(parts)
    elif cmd == "event":
        cmd_event(parts)
    elif cmd == "item":
        cmd_item(parts)
    elif cmd == "state":
        cmd_state(parts)
    elif cmd == "crime":
        cmd_crime(parts)
    elif cmd == "raid":
        cmd_raid(parts)
    elif cmd == "gw":
        cmd_gw(parts)
    elif cmd == "power":
        cmd_power(parts)
    elif cmd == "restock":
        cmd_restock()
    elif cmd == "showcase":
        cmd_showcase(parts)
    elif cmd == "attract":
        cmd_attract()
    elif cmd == "goto":
        cmd_goto(parts)
    elif cmd == "bag":
        cmd_bag(parts)
    elif cmd == "pack":
        cmd_pack(parts)
    elif cmd == "save":
        cmd_save()
    elif cmd == "echo":
        cmd_echo(parts)
    elif cmd == "clear":
        g_log = []
    else:
        log_line("【错误】未知指令 '" + cmd + "' — 输入 help 查看帮助")

# ============ 分词与解析 (v0.1.1) ============

# 分词: 按空格切, 但引号串 "..." 与花括号块 {...} (可嵌套) 保持为一个整体 token。
# 引号/花括号保留在 token 里, 供下游识别类型。出错置 g_err 并返回已切出的部分。
func tokenize(s):
    var toks = []
    var cur = ""
    var i = 0
    var n = len(s)
    while i < n:
        var c = s[i]
        if c == " ":
            if len(cur) > 0:
                push(toks, cur)
                cur = ""
            i = i + 1
        elif c == Q:
            # 引号段: 拼进当前 token (可与其他字符粘连, 如 name="x")
            cur = cur + Q
            i = i + 1
            var qclosed = false
            while i < n:
                cur = cur + s[i]
                if s[i] == Q:
                    qclosed = true
                    i = i + 1
                    break
                i = i + 1
            if not qclosed:
                g_err = "引号未闭合 (第 " + str(i) + " 个字符附近)"
                return toks
        elif c == "{{":
            # 花括号块: 深度配对 + 块内引号跳过, 整体留在当前 token
            var depth = 0
            var bclosed = false
            while i < n:
                var ch = s[i]
                cur = cur + ch
                i = i + 1
                if ch == Q:
                    var iq = false
                    while i < n:
                        cur = cur + s[i]
                        if s[i] == Q:
                            iq = true
                            i = i + 1
                            break
                        i = i + 1
                    if not iq:
                        g_err = "花括号内的引号未闭合"
                        return toks
                elif ch == "{{":
                    depth = depth + 1
                elif ch == "}}":
                    depth = depth - 1
                    if depth == 0:
                        bclosed = true
                        break
            if not bclosed:
                g_err = "花括号未闭合 (缺 }})"
                return toks
        else:
            cur = cur + c
            i = i + 1
    if len(cur) > 0:
        push(toks, cur)
    return toks

# 取子串 [a, b)
func substr(s, a, b):
    var r = ""
    for i in range(a, b):
        r = r + s[i]
    return r

# 去首尾空格
func trim(s):
    var a = 0
    var b = len(s)
    while a < b and s[a] == " ":
        a = a + 1
    while b > a and s[b - 1] == " ":
        b = b - 1
    return substr(s, a, b)

# 去掉包裹引号 (有则去, 无则原样)
func unquote(s):
    var n = len(s)
    if n >= 2 and s[0] == Q and s[n - 1] == Q:
        return substr(s, 1, n - 1)
    return s

# 小写转大写 (crime id 容错用; pss 无内建 upper)
var LOWERS = "abcdefghijklmnopqrstuvwxyz"
var UPPERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
func to_upper(s):
    var r = ""
    for i in range(0, len(s)):
        var c = s[i]
        var hit = false
        for j in range(0, 26):
            if c == LOWERS[j]:
                r = r + UPPERS[j]
                hit = true
                break
        if not hit:
            r = r + c
    return r

# 按顶层逗号切分 (中英文逗号皆可); 引号与嵌套花括号内的逗号不切
func split_top(s):
    var out = []
    var cur = ""
    var depth = 0
    var inq = false
    for i in range(0, len(s)):
        var c = s[i]
        if inq:
            cur = cur + c
            if c == Q:
                inq = false
        elif c == Q:
            inq = true
            cur = cur + c
        elif c == "{{":
            depth = depth + 1
            cur = cur + c
        elif c == "}}":
            depth = depth - 1
            cur = cur + c
        elif (c == "," or c == "，") and depth == 0:
            push(out, cur)
            cur = ""
        else:
            cur = cur + c
    push(out, cur)
    return out

# 找顶层第一个 = 的位置 (引号/花括号内不算); 找不到返回 -1
func find_top_eq(s):
    var depth = 0
    var inq = false
    for i in range(0, len(s)):
        var c = s[i]
        if inq:
            if c == Q:
                inq = false
        elif c == Q:
            inq = true
        elif c == "{{":
            depth = depth + 1
        elif c == "}}":
            depth = depth - 1
        elif c == "=" and depth == 0:
            return i
    return -1

# 纯整数串判定 (允许前导 +/-): int() 解析失败会抛错出回调, 必须先挡
func is_num(s):
    if len(s) == 0:
        return false
    var start = 0
    if s[0] == "-" or s[0] == "+":
        if len(s) == 1:
            return false
        start = 1
    for i in range(start, len(s)):
        if not has("0123456789", s[i]):
            return false
    return true

# 小数字串判定 (恰好一个小数点, 至少一位数字)
func is_fnum(s):
    if len(s) == 0:
        return false
    var start = 0
    if s[0] == "-" or s[0] == "+":
        if len(s) == 1:
            return false
        start = 1
    var dot = false
    var digits = 0
    for i in range(start, len(s)):
        var c = s[i]
        if c == ".":
            if dot:
                return false
            dot = true
        elif has("0123456789", c):
            digits = digits + 1
        else:
            return false
    return dot and digits > 0

# 解析值: "引号串"(可含空格) / {嵌套字典} / 整数 / 小数 / true / false / null / 裸字符串
func parse_value(vs):
    var n = len(vs)
    if n >= 2 and vs[0] == Q and vs[n - 1] == Q:
        return substr(vs, 1, n - 1)
    if n >= 1 and vs[0] == "{{":
        if n < 2 or vs[n - 1] != "}}":
            g_err = "字典值花括号未配对: " + vs
            return null
        return parse_dict(vs)
    if is_num(vs):
        return int(vs)
    if is_fnum(vs):
        return float(vs)
    if vs == "true":
        return true
    if vs == "false":
        return false
    if vs == "null":
        return null
    return vs

# 解析 {...} 块为 dict (支持任意深度嵌套); 出错置 g_err 返回 null
func parse_dict(s):
    var inner = substr(s, 1, len(s) - 1)
    var d = {}
    var entries = split_top(inner)
    for e0 in entries:
        var e = trim(e0)
        if len(e) == 0:
            continue
        var eq = find_top_eq(e)
        if eq <= 0:
            g_err = "条目 '" + e + "' 须为 k=v 形式"
            return null
        var k = trim(substr(e, 0, eq))
        var vs = trim(substr(e, eq + 1, len(e)))
        if len(k) == 0 or len(vs) == 0:
            g_err = "条目 '" + e + "' 的键或值为空"
            return null
        var v = parse_value(vs)
        if g_err != "":
            return null
        d[k] = v
    return d

# 把解析出的 kv 合并进 give 的 opts/data: 内置键(name/desc/flavor/quality/to/value/uses)只收标量,
# 其余键 (值可嵌套 dict) 进自定义数据 data。出错记日志并返回 false。
func give_apply(d, opts, data):
    for k in keys(d):
        var v = d[k]
        var t = type(v)
        if k == "name" or k == "desc" or k == "flavor" or k == "quality":
            if t == "dict" or t == "array":
                log_line("【错误】" + k + " 只接受字符串值, 不能是字典")
                return false
            opts[k] = str(v)
        elif k == "to":
            if t != "string" or (v != "inventory" and v != "counter_out" and v != "counter_in"):
                log_line("【错误】to 仅支持 inventory/counter_out/counter_in")
                return false
            opts["to"] = v
        elif k == "value" or k == "uses":
            if t != "int":
                log_line("【错误】" + k + " 须为整数")
                return false
            opts[k] = v
        else:
            data[k] = v
    return true

# 值 → 回显文本 (dict/list 递归拼成 JSON 风格)
func fmt_val(v):
    var t = type(v)
    if t == "dict":
        var ps = []
        for k in keys(v):
            push(ps, k + "=" + fmt_val(v[k]))
        return "{{" + join(ps, ",") + "}}"
    if t == "array":
        var ps2 = []
        for x in v:
            push(ps2, fmt_val(x))
        return "[" + join(ps2, ",") + "]"
    if t == "string":
        return Q + v + Q
    if t == "bool":
        if v:
            return "true"
        return "false"
    if t == "null":
        return "null"
    return str(v)

# ============ 工具 ============

func need_game():
    var st = shop.status()
    if not st.in_game:
        log_line("【错误】不在对局中, 该指令不可用")
        return false
    return true

# ============ 指令实现 ============

func cmd_help():
    log_line("—— 指令清单 (前导 / 可选; 分组) ——")
    log_line("[基础] help / echo <text> / clear / save / day / pack list")
    log_line("[物品] give <id> [count] [k=v ...] [{{k=v,...}}] — 发物品 (内置键 to=/name=/desc=/flavor=/value=/uses=/quality=)")
    log_line("  to=inventory(默认) | counter_out(门口柜台) | counter_in(店内柜台); item <id> 查物品")
    log_line("[玩家] cash [add N|set N] / rep [faction] [add N] / power [which] [add N]")
    log_line("[商店] npc list|queue|spawn <id>|leave|rep / event <id> / showcase [clear yes] / attract / restock")
    log_line("[犯罪] crime list / crime add <ID> <n> [\"显示名\"] / crime clear <ID> / crime clearall / crime evidence [set N]")
    log_line("  罪名: " + join(CRIME_IDS, "/") + " (小写自动转大写)")
    log_line("[gunworks] raid maps / raid unlock all|<场景id> / raid lock <场景id> / raid cd [clear|<场景id> <天数>] / raid status [heal]")
    log_line("  gw parts <材料> / gw repair [break] / gw tank <流体> [mB]")
    log_line("  材料: " + join(GW_MATS, "/") + "; 流体加 fuel")
    log_line("[移动] goto [场景id|back] (无参=列场景)")
    log_line("[危险] bag clear yes / showcase clear yes — 需 yes 二次确认")
    log_line("[存档] state get <k> / state set <k> <v> (本包 KV)")

func cmd_give(parts):
    if len(parts) < 2:
        log_line("【用法】give <id> [count] [k=v ...] [{{k=v,...}}]")
        return
    var id = unquote(parts[1])
    var count = 1
    var kvStart = 2
    if len(parts) >= 3 and is_num(parts[2]):
        count = int(parts[2])
        kvStart = 3
    if count < 1 or count > 9999:
        log_line("【错误】count 须在 1..9999, 实为 " + str(count))
        return
    var opts = {}
    var data = {}
    g_err = ""
    for i in range(kvStart, len(parts)):
        var tok = parts[i]
        if len(tok) == 0:
            continue
        if tok[0] == "{{":
            # {} 块: 递归解析后合并
            if len(tok) < 2 or tok[len(tok) - 1] != "}}":
                log_line("【错误】花括号块须以 }} 收尾: " + tok)
                return
            var dd = parse_dict(tok)
            if g_err != "":
                log_line("【错误】" + g_err)
                return
            if not give_apply(dd, opts, data):
                return
        else:
            # 旧式 k=v (值可为引号串, 也可直接写嵌套 {} 值)
            var eq = find_top_eq(tok)
            if eq <= 0:
                log_line("【错误】参数 '" + tok + "' 须为 k=v 形式")
                return
            var single = {}
            single[substr(tok, 0, eq)] = parse_value(substr(tok, eq + 1, len(tok)))
            if g_err != "":
                log_line("【错误】" + g_err)
                return
            if not give_apply(single, opts, data):
                return
    if len(data) > 0:
        opts["data"] = data
    var where = "背包"
    if has(opts, "to"):
        if opts["to"] == "counter_out":
            where = "门口柜台"
        elif opts["to"] == "counter_in":
            where = "店内柜台"
    if items.give(id, count, opts):
        var msg = "已发放 " + id + " ×" + str(count) + " → " + where
        var extras = []
        for bk in ["name", "desc", "flavor", "quality"]:
            if has(opts, bk):
                push(extras, bk + "=" + Q + opts[bk] + Q)
        for nk in ["value", "uses"]:
            if has(opts, nk):
                push(extras, nk + "=" + str(opts[nk]))
        if len(data) > 0:
            push(extras, "data=" + fmt_val(data))
        if len(extras) > 0:
            msg = msg + " (" + join(extras, ", ") + ")"
        log_line(msg)
    else:
        log_line("【错误】发放失败 (物品 id 不存在或不在对局): " + id)

func cmd_cash(parts):
    if len(parts) == 1:
        if not need_game():
            return
        log_line("现金: " + str(player.cash()))
        return
    var sub = parts[1]
    if sub == "add" or sub == "set":
        if len(parts) < 3 or not is_num(parts[2]):
            log_line("【用法】cash " + sub + " N")
            return
        if not need_game():
            return
        var n = int(parts[2])
        if sub == "set":
            n = n - player.cash()
        player.add_cash(n)
        log_line("现金: " + str(player.cash()))
    else:
        log_line("【用法】cash / cash add N / cash set N")

func cmd_rep(parts):
    if len(parts) == 1:
        if not need_game():
            return
        for f in FACTIONS:
            log_line(f + ": " + str(rep.get(f)))
        return
    var f = unquote(parts[1])
    if not has(FACTIONS, f):
        log_line("【错误】未知派系 '" + f + "' (可用: " + join(FACTIONS, "/") + ")")
        return
    if not need_game():
        return
    if len(parts) == 2:
        log_line(f + ": " + str(rep.get(f)))
        return
    if parts[2] == "add":
        if len(parts) < 4 or not is_num(parts[3]):
            log_line("【用法】rep <faction> add N")
            return
        rep.add(f, int(parts[3]))
        log_line(f + ": " + str(rep.get(f)))
    else:
        log_line("【用法】rep [faction] / rep <faction> add N")

func cmd_day():
    if not need_game():
        return
    log_line("第 " + str(time.day()) + " 天 (rel_day=" + str(time.rel_day()) + ", weekday=" + str(time.weekday()) + ")")

func cmd_npc(parts):
    if len(parts) < 2:
        log_line("【用法】npc list | npc queue | npc spawn <id> | npc leave | npc rep")
        return
    var sub = parts[1]
    if sub == "list":
        var all = npc.list()
        if len(all) == 0:
            log_line("(无注册 NPC — 内容包未注册任何自定义客户)")
        else:
            for n in all:
                var label = n.id + " [" + n.intent + "]"
                if len(n.name) > 0:
                    label = label + " " + n.name
                log_line(label + " (schedule: " + n.schedule_kind + ")")
    elif sub == "queue":
        var q = shop.queue()
        if len(q) == 0:
            log_line("(今日待客队列空)")
        else:
            for c in q:
                log_line(str(c.idx + 1) + ". " + c.name + " [" + c.intent + "] ¥" + str(c.cash))
    elif sub == "spawn":
        if len(parts) < 3:
            log_line("【用法】npc spawn <id>")
            return
        var target = unquote(parts[2])
        var found = false
        for n in npc.list():
            if n.id == target:
                found = true
                break
        if not found:
            log_line("【错误】NPC '" + target + "' 未注册 (npc list 查看已注册)")
            return
        npc.schedule(target)
        log_line("已挂起生成: " + target + " (下次客户生成时强制到店)")
    elif sub == "leave":
        if not need_game():
            return
        var nm = shop.status().current_name
        if npc.leave_current():
            if len(nm) > 0:
                log_line("已请离: " + nm)
            else:
                log_line("已请离当前客户")
        else:
            log_line("(当前店内无客户可请离)")
    elif sub == "rep":
        if not need_game():
            return
        var cc = shop.current_client()
        if cc == null:
            log_line("(当前店内无客户)")
            return
        var rs = "(非六大派系, 无声望数值)"
        if has(FACTION_TO_REP, cc.faction):
            var rk = FACTION_TO_REP[cc.faction]
            rs = rk + " " + str(rep.get(rk))
        log_line(cc.name + " [" + cc.intent + "] 派系 " + cc.faction + " · 声望 " + rs)
        log_line("(原版无单 NPC 好感 — 只有派系级声望 rep 与势力值 power upper_friend)")
    else:
        log_line("【用法】npc list | npc queue | npc spawn <id> | npc leave | npc rep")

# event <id> — 立即触发商店事件 (store_event.trigger, v1.16.1)
func cmd_event(parts):
    if len(parts) < 2:
        log_line("【用法】event <id> — 立即触发商店事件 (已注册 id 或原版事件 id)")
        return
    if not need_game():
        return
    var eid = unquote(parts[1])
    if store_event.trigger(eid):
        log_line("已触发商店事件: " + eid)
    else:
        log_line("【错误】事件 '" + eid + "' 未注册且不在原版事件池")

func cmd_item(parts):
    if len(parts) < 2:
        log_line("【用法】item <id>")
        return
    var id = unquote(parts[1])
    var nm = items.name(id)
    if nm == null:
        nm = "(未知物品)"
    var held = "否"
    if items.has(id, 1):
        held = "是"
    log_line(id + ": " + nm + " · 单价 " + str(items.value(id)) + " · 持有 " + held)

func cmd_state(parts):
    if len(parts) >= 2 and parts[1] == "get":
        if len(parts) < 3:
            log_line("【用法】state get <k>")
            return
        log_line(parts[2] + " = " + str(state.get(parts[2], "(未设置)")))
    elif len(parts) >= 2 and parts[1] == "set":
        if len(parts) < 4:
            log_line("【用法】state set <k> <v>")
            return
        var val = unquote(parts[3])
        if is_num(val):
            state.set(parts[2], int(val))
        elif is_fnum(val):
            state.set(parts[2], float(val))
        elif val == "true":
            state.set(parts[2], true)
        elif val == "false":
            state.set(parts[2], false)
        else:
            state.set(parts[2], val)
        log_line(parts[2] + " 已写入")
    else:
        log_line("【用法】state get <k> / state set <k> <v>")

# pack list — 已加载内容包 (pack.list, Events v1.17.0)
func cmd_pack(parts):
    if len(parts) < 2 or parts[1] == "list":
        var all = pack.list()
        if len(all) == 0:
            log_line("(无已加载内容包)")
            return
        for p in all:
            var mark = "folder"
            if p.source == "dll":
                mark = "dll"
            var line = p.id + " v" + p.version + " [" + mark + "]"
            if len(p.name) > 0:
                line = line + " " + p.name
            if not p.valid:
                line = line + " (无效)"
            log_line(line)
    else:
        log_line("【用法】pack list")

# save — 立即存档 (game.save, Events v1.17.0; 触发原版 SaveGame, 模组状态随钩子同步落盘)
func cmd_save():
    if not need_game():
        return
    if game.save():
        log_line("已存档 (与晚上睡觉同一存档管线)")
    else:
        log_line("【错误】存档失败 (不在对局?)")

func cmd_echo(parts):
    var rest = []
    for i in range(1, len(parts)):
        push(rest, unquote(parts[i]))
    log_line(join(rest, " "))

# ============ v0.2.0 扩展指令 (20 条; 需 PSApi ≥ v2.0.2) ============

# ---- 犯罪系 (crime) ----

func cmd_crime(parts):
    if len(parts) < 2:
        log_line("【用法】crime list | crime add <ID> <n> [\"显示名\"] | crime clear <ID> | crime clearall | crime evidence [set N]")
        return
    var sub = parts[1]
    if sub == "list":
        if not need_game():
            return
        var r = crime.list()
        if len(r.crimes) == 0:
            log_line("治安档案干净 (无犯罪记录)")
        else:
            for c in r.crimes:
                log_line("  " + c.id + " ×" + str(c.amount) + " (累计 " + str(c.total) + ")")
        log_line("证据等级: " + str(r.evidence) + " (" + r.evidence_display + ") · 总罪值 " + str(r.total_value) + " · 罚款 " + str(r.fine))
        if r.biggest != null:
            log_line("最重罪: " + str(r.biggest) + " · 预估: " + str(r.sentence))
    elif sub == "add":
        if len(parts) < 4 or not is_num(parts[3]):
            log_line("【用法】crime add <ID> <n> [\"显示名\"] — 罪名小写自动转大写")
            return
        if not need_game():
            return
        var cid = to_upper(unquote(parts[2]))
        var nm = null
        if len(parts) >= 5:
            nm = unquote(parts[4])
        if not has(CRIME_IDS, cid) and nm == null:
            log_line("【错误】未知罪名 '" + cid + "' (可用: " + join(CRIME_IDS, "/") + "; 表外罪名须带显示名)")
            return
        var amt = int(parts[3])
        if nm == null:
            crime.commit(cid, amt)
            log_line("已记罪: " + cid + " ×" + str(amt) + " — crime list 查看")
        else:
            crime.commit(cid, amt, nm)
            log_line("已记罪: " + cid + " ×" + str(amt) + " (显示名: " + nm + ")")
    elif sub == "clear":
        if len(parts) < 3:
            log_line("【用法】crime clear <ID>")
            return
        if not need_game():
            return
        var cid2 = to_upper(unquote(parts[2]))
        var n = crime.clear(cid2)
        if n > 0:
            log_line("已清除 " + cid2 + " 共 " + str(n) + " 条 (三表同删)")
        else:
            log_line("档案里没有 " + cid2 + " (crime list 核对)")
    elif sub == "clearall":
        if not need_game():
            return
        crime.clear_all()
        log_line("治安档案已清空 (原版 ResetCrime)")
    elif sub == "evidence":
        if not need_game():
            return
        if len(parts) == 2:
            log_line("证据等级: " + str(crime.evidence()) + " /100")
        elif len(parts) == 4 and parts[2] == "set" and is_num(parts[3]):
            log_line("证据等级: " + str(crime.evidence(int(parts[3]))) + " /100 (写值钳 0-100)")
        else:
            log_line("【用法】crime evidence [set N] — N 钳 0..100")
    else:
        log_line("【用法】crime list | crime add <ID> <n> [\"显示名\"] | crime clear <ID> | crime clearall | crime evidence [set N]")

# ---- gunworks 系 (raid/gw; 跨包存档走 state.pget/pset) ----

func raid_map_info(sid):
    for m in RAID_MAPS:
        if m.id == sid:
            return m
    return null

func raid_unlocks_read():
    var un = state.pget("gunworks", "ps_raid_unlocks", null)
    if type(un) != "array":
        return []
    return un

func raid_cd_read():
    var cd = state.pget("gunworks", "ps_raid_cd", null)
    if type(cd) != "dict":
        return {}
    return cd

# dict 删除键 = 重建 (pss 无 del d[k]; 防留 null 值坑坏 gunworks 遍历)
func dict_without(d, drop):
    var r = {}
    for k in keys(d):
        if k != drop:
            r[k] = d[k]
    return r

func cmd_raid(parts):
    if len(parts) < 2:
        log_line("【用法】raid maps | raid unlock all|<场景id> | raid lock <场景id> | raid cd [clear|<场景id> <天数>] | raid status [heal]")
        return
    var sub = parts[1]
    if sub == "maps":
        if not need_game():
            return
        var un = raid_unlocks_read()
        var cd = raid_cd_read()
        for m in RAID_MAPS:
            var st = "[锁]"
            if m.id in un:
                st = "[开]"
            var extra = ""
            if has(cd, m.id):
                var e = cd[m.id]
                var ed = 0
                var eu = 0
                if has(e, "d"):
                    ed = e.d
                if has(e, "u"):
                    eu = e.u
                if eu > 0:
                    extra = " · 动荡 " + str(ed) + " 天"
                else:
                    extra = " · 冷却 " + str(ed) + " 天"
            log_line(st + " " + m.name + " " + str(m.star) + "★ (" + m.id + ")" + extra)
    elif sub == "unlock":
        if len(parts) < 3:
            log_line("【用法】raid unlock all|<场景id>")
            return
        if not need_game():
            return
        var target = unquote(parts[2])
        var un2 = raid_unlocks_read()
        if target == "all":
            for m2 in RAID_MAPS:
                if not (m2.id in un2):
                    push(un2, m2.id)
            state.pset("gunworks", "ps_raid_unlocks", un2)
            log_line("已解锁全部 10 图 (ps_raid_unlocks 共 " + str(len(un2)) + " 条, 门禁下帧重读生效)")
        else:
            var info = raid_map_info(target)
            if info == null:
                log_line("【错误】未知场景 '" + target + "' (raid maps 查看 10 图 id)")
                return
            if info.id in un2:
                log_line(info.name + " 本就已解锁")
                return
            push(un2, info.id)
            state.pset("gunworks", "ps_raid_unlocks", un2)
            log_line("已解锁: " + info.name + " (" + info.id + ") — 区域选择处立即可进")
    elif sub == "lock":
        if len(parts) < 3:
            log_line("【用法】raid lock <场景id>")
            return
        if not need_game():
            return
        var info2 = raid_map_info(unquote(parts[2]))
        if info2 == null:
            log_line("【错误】未知场景 '" + unquote(parts[2]) + "' (raid maps 查看 10 图 id)")
            return
        var un3 = raid_unlocks_read()
        if not (info2.id in un3):
            log_line(info2.name + " 本就是锁定状态")
            return
        var nu = []
        for x in un3:
            if x != info2.id:
                push(nu, x)
        state.pset("gunworks", "ps_raid_unlocks", nu)
        log_line("已重新锁定: " + info2.name + " (剩 " + str(len(nu)) + " 图解锁)")
    elif sub == "cd":
        if not need_game():
            return
        if len(parts) == 2:
            var cd2 = raid_cd_read()
            var ks = keys(cd2)
            if len(ks) == 0:
                log_line("(无冷却/动荡中的地图)")
            else:
                for k in ks:
                    var e2 = cd2[k]
                    var tag = "冷却"
                    if has(e2, "u") and e2.u > 0:
                        tag = "动荡"
                    var dd = 0
                    if has(e2, "d"):
                        dd = e2.d
                    log_line("  " + k + ": " + tag + " " + str(dd) + " 天")
        elif len(parts) == 3 and parts[2] == "clear":
            state.pset("gunworks", "ps_raid_cd", {})
            log_line("已清空全部地图冷却/动荡")
        elif len(parts) == 4 and is_num(parts[3]):
            var sid = unquote(parts[2])
            var info3 = raid_map_info(sid)
            if info3 == null:
                log_line("【错误】未知场景 '" + sid + "' (raid maps 查看 10 图 id)")
                return
            var days = int(parts[3])
            if days < 0 or days > 30:
                log_line("【错误】天数须在 0..30 (0=清除该图冷却)")
                return
            var cd3 = raid_cd_read()
            if days == 0:
                state.pset("gunworks", "ps_raid_cd", dict_without(cd3, sid))
                log_line("已清除 " + info3.name + " 的冷却/动荡")
            else:
                cd3[sid] = {d = days, u = 0}
                state.pset("gunworks", "ps_raid_cd", cd3)
                log_line("已设 " + info3.name + " 冷却 " + str(days) + " 天 (门禁显示 冷却中)")
        else:
            log_line("【用法】raid cd [clear|<场景id> <天数>] — 天数 0=清除, clear=全清")
    elif sub == "status":
        if not need_game():
            return
        if len(parts) == 2:
            var s = state.pget("gunworks", "ps_raid_status", null)
            if s == null:
                log_line("人物状态: 满 (无 raid 损伤记录, hp 100/100 · 体力 100/100)")
            else:
                log_line("人物状态: hp " + str(s.hp) + "/100 · 体力 " + str(s.stamina) + "/100")
        elif len(parts) == 3 and parts[2] == "heal":
            state.pset("gunworks", "ps_raid_status", {hp = 100, stamina = 100})
            log_line("已回满: hp 100/100 · 体力 100/100")
        else:
            log_line("【用法】raid status [heal]")
    else:
        log_line("【用法】raid maps | raid unlock all|<场景id> | raid lock <场景id> | raid cd [clear|<场景id> <天数>] | raid status [heal]")

func cmd_gw(parts):
    if len(parts) < 2:
        log_line("【用法】gw parts <材料> | gw repair [break] | gw tank <流体> [mB]")
        return
    var sub = parts[1]
    if sub == "parts":
        if len(parts) < 3 or not has(GW_MATS, parts[2]):
            log_line("【用法】gw parts <材料> (" + join(GW_MATS, "/") + ")")
            return
        if not need_game():
            return
        var m = parts[2]
        var ok = 0
        for pid in GW_PARTS:
            if items.give(pid, 1, {data = {mat = m}}):
                ok = ok + 1
        if items.give("gunworks:repair_kit", 1, {data = {mat = m}, value = GW_KIT_VALUES[m]}):
            ok = ok + 1
        log_line("已发放 " + GW_MAT_CN[m] + "制套件 " + str(ok) + "/10 (9 部件+维修件, 全带 mat NBT, 落背包)")
    elif sub == "repair":
        if not need_game():
            return
        var breaking = len(parts) >= 3 and parts[2] == "break"
        var fixed = 0
        var seen = 0
        for gid in GW_GUNS:
            for h in items.find_all(gid):
                var mx = h.get_data("ps_dur_max", 0)
                if mx <= 0:
                    continue
                seen = seen + 1
                if breaking:
                    h.set_data("ps_dur", 1)
                else:
                    h.set_data("ps_dur", mx)
                    h.set_data("ps_wear", 0)
                    h.set_data("ps_broken", null)
                fixed = fixed + 1
        if breaking:
            log_line("已打残 " + str(fixed) + " 把成品枪 (ps_dur=1; 背包+后仓扫到 " + str(seen) + " 把带耐久枪)")
        else:
            log_line("已修满 " + str(fixed) + " 把 (ps_dur=max·磨损清零·破损标记已除; 扫到 " + str(seen) + " 把)")
    elif sub == "tank":
        if len(parts) < 3 or not has(GW_FLUIDS, parts[2]):
            log_line("【用法】gw tank <流体> [mB=100] (" + join(GW_FLUIDS, "/") + ")")
            return
        var amt = 100
        if len(parts) >= 4:
            if not is_num(parts[3]):
                log_line("【用法】gw tank <流体> [mB=100] — mB 须为整数")
                return
            amt = int(parts[3])
        if amt < 1 or amt > 100:
            log_line("【错误】mB 须在 1..100 (单罐容量 100)")
            return
        if not need_game():
            return
        if items.give("gunworks:fluid_tank", 1, {data = {fluid = parts[2], amount = amt, cap = 100}}):
            log_line("已发放储罐: " + parts[2] + " " + str(amt) + "/100 mB → 背包")
        else:
            log_line("【错误】发放失败 (不在对局?)")
    else:
        log_line("【用法】gw parts <材料> | gw repair [break] | gw tank <流体> [mB]")

# ---- 原版通用系 ----

func cmd_power(parts):
    if len(parts) == 1:
        if not need_game():
            return
        for k in POWERS:
            log_line(k + ": " + str(power.get(k)))
        return
    var k2 = parts[1]
    if not has(POWERS, k2):
        log_line("【错误】未知势力 '" + k2 + "' (可用: " + join(POWERS, "/") + ")")
        return
    if not need_game():
        return
    if len(parts) == 2:
        log_line(k2 + ": " + str(power.get(k2)))
        return
    if parts[2] == "add" and len(parts) >= 4 and is_num(parts[3]):
        power.add(k2, int(parts[3]))
        log_line(k2 + ": " + str(power.get(k2)))
    else:
        log_line("【用法】power [which] [add N] — 五势力数值 (" + join(POWERS, "/") + ")")

func cmd_restock():
    if not need_game():
        return
    log_line("已强刷当前商人上架表 (注入 " + str(inject.restock_current()) + " 件)")

func cmd_showcase(parts):
    if len(parts) >= 2 and parts[1] == "clear":
        if len(parts) >= 3 and parts[2] == "yes":
            if not need_game():
                return
            var n2 = 0
            for h2 in shop.showcase_items():
                if items.consume(h2):
                    n2 = n2 + 1
            log_line("已清空展示柜 (移除 " + str(n2) + " 堆, 不返还)")
        else:
            log_line("【确认】展示柜清空不可恢复 — 输入 showcase clear yes 执行")
        return
    if not need_game():
        return
    var hs = shop.showcase_items()
    if len(hs) == 0:
        log_line("(展示柜空)")
    else:
        for h in hs:
            log_line("  " + h.id + " ×" + str(h.count))
        log_line("共 " + str(len(hs)) + " 堆 (清空: showcase clear yes)")

func cmd_attract():
    if not need_game():
        return
    var r = shop.attract()
    if r == null:
        log_line("(吸引力数据当前不可用)")
        return
    log_line("吸引力: " + str(r.value) + " · 生成率 " + str(r.spawn_chance) + " · 普通客 " + str(r.normal_count))
    log_line("门槛 t1/t2/t3: " + str(r.t1) + "/" + str(r.t2) + "/" + str(r.t3) + " · extra10/25/50: " + str(r.extra10) + "/" + str(r.extra25) + "/" + str(r.extra50) + " · rich400/650: " + str(r.rich400) + "/" + str(r.rich650))
    log_line("(只读 — 吸引力由店内陈设决定, 无设置接口)")

func cmd_goto(parts):
    if len(parts) >= 2 and parts[1] == "back":
        if not need_game():
            return
        if scenes.back():
            log_line("已返回上一场景")
        else:
            log_line("【错误】返回失败 (不在场景中?)")
        return
    if not need_game():
        return
    if len(parts) < 2:
        var rows = scenes.list()
        if len(rows) == 0:
            log_line("(无外出场景 — 内容包未注册或不在地图状态)")
        else:
            for s in rows:
                var tag = "[开]"
                if s.locked:
                    tag = "[锁]"
                log_line(tag + " " + s.id + " " + s.name + " 危险" + str(s.danger) + "★")
            log_line("用法: goto <场景id> / goto back (锁定图先 raid unlock)")
        return
    var sid = unquote(parts[1])
    if scenes.enter(sid):
        log_line("已进入场景: " + sid + " (返回: goto back)")
    else:
        log_line("【错误】进不去 " + sid + " (不存在/门禁锁定/当前不可用 — raid maps 查解锁)")

func cmd_bag(parts):
    if len(parts) >= 2 and parts[1] == "clear":
        if len(parts) >= 3 and parts[2] == "yes":
            if not need_game():
                return
            var n = 0
            for h in items.inventory():
                if items.consume(h):
                    n = n + 1
            log_line("已清空背包+后仓 (移除 " + str(n) + " 堆, 不返还)")
        else:
            log_line("【确认】背包+后仓清空不可恢复 — 输入 bag clear yes 执行")
        return
    log_line("【用法】bag clear yes — 清空背包+后仓 (需 yes 二次确认)")
