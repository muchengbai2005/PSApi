# distribution.pss — 流通渠道 (gunworks v0.10.0): 博士夜间商店机器上架 + 原版 NPC 货架流通 + 原版掷骰池
#
# 一、博士上架 (inject.doctor + day_wake 调节):
#   三台机器注册进博士商店池, 每天按天数阈值+概率决定当天是否上架:
#     组装台   gunworks:gw_bench      rel_day≥4  起 40%
#     打印机   gunworks:part_printer  rel_day≥8  起 35%
#     分析仪   gunworks:item_analyzer rel_day≥12 起 35%
#   (阈值/概率可调; 设计意图: 老枪货架是主渠道, 博士是错过老枪后的夜间备胎,
#    越贵的机器越晚开放。inject.tune 覆盖层仅本次会话, 每天重算 = 幂等。)
#   idx 管理: 不写死序号 — inject.list 的 idx 受全部包的注册顺序影响,
#   每天 day_wake 里按 channel+id 现查现调, 对注册顺序零假设。
#
# 二、原版 NPC 货架流通 (inject.sell_shelf, 原版 SELL/SELLNBUY 客户对话末行播完时概率摆货):
#   v0.10.0 中间档 (v0.9.1 的 0.04-0.06 太低, v0.9.0 的 0.10-0.15 太高), 数量支持 "min-max" 随机:
#     部件 (组装台材料)   0.08-0.10  数量 1-3  barrel_s/grip_s 0.10, mag 0.09, barrel_m/receiver_s 0.08
#     枪械零件 (散货)     0.06-0.08  数量 1-3  pistol_parts 0.08, smg_parts 0.06
#     模组枪 (违禁品)     0.03       恒 1      gw_pistol/gw_smg
#     成品数据卡 (满5次)  0.02-0.03  恒 1      barrel 0.03, grip 0.02  ← 仍全场最低
#     空白数据卡          0.05       恒 1
#     原版枪械/配件/近战  0.02-0.05  恒 1      (8 条, id 均核实自 UserData/items_catalog.md)
#   部件走这里流进市场 = 玩家卖枪给原版 NPC 的回收环, 也是"民间出现组装枪"的世界观暗示。
#
# 三、原版掷骰池 (inject.loot_pool, v1.10.0): 拾荒客/小贼等 SELL 客户带货与远征的底层池。
#   mcb_weapon_gun1 → makeshiftWeapon 0.03; 4 种零件 → material 0.02-0.04; 空白卡 → material 0.02。
#   不进池的: 成品数据卡(次数消耗品, 入池会扰动定价体系)/机器(高价值设备, 走博士+老枪渠道)/
#   证书(剧情伪证, 不该野摊流通)。

# ---- 博士注册 (加载期一次性; 上架开关每天在 day_wake 重算) ----
inject.doctor("gunworks:gw_bench", 1)
inject.doctor("gunworks:part_printer", 1)
inject.doctor("gunworks:item_analyzer", 1)

# 天数阈值+概率表 (id → {day, pct})
var DOCTOR_PLAN = {
    "gunworks:gw_bench"      = {day = 4,  pct = 0.40},
    "gunworks:part_printer"  = {day = 8,  pct = 0.35},
    "gunworks:item_analyzer" = {day = 12, pct = 0.35},
}

on day_wake():
    var today = time.rel_day()
    for row in inject.list():
        if row.channel != "doctor":
            continue
        var plan = DOCTOR_PLAN[row.id]
        if plan == null:
            continue
        var up = today >= plan.day and randf() < plan.pct
        inject.tune(row.idx, {enabled = up})
    inject.reset_tracking()
    log.info("[gunworks] 博士商店今日上架已按天数/概率重算 (day={today})")

# ---- 原版 NPC 货架流通 ----
# 部件 (组装台材料; 常见小件概率高, 数量 1-3 随机)
inject.sell_shelf("gunworks:part_barrel_s", "1-3", 0.10)
inject.sell_shelf("gunworks:part_grip_s", "1-3", 0.10)
inject.sell_shelf("gunworks:part_mag", "1-3", 0.09)
inject.sell_shelf("gunworks:part_barrel_m", "1-3", 0.08)
inject.sell_shelf("gunworks:part_receiver_s", "1-3", 0.08)
# 成品数据卡 (满 5 次; 分析仪产物外流的稀货, 仍全场最低)
inject.sell_shelf("gunworks:datacard_barrel", 1, 0.03, {uses = 5})
inject.sell_shelf("gunworks:datacard_grip", 1, 0.02, {uses = 5})
#空白数据卡 (打印体系原料)
inject.sell_shelf("gunworks:datacard_blank", 1, 0.05)
# 枪械零件 (老枪之外的散货, 数量 1-3 随机)
inject.sell_shelf("gunworks:pistol_parts", "1-3", 0.08)
inject.sell_shelf("gunworks:smg_parts", "1-3", 0.06)
inject.sell_shelf("gunworks:rifle_parts", "1-3", 0.04)
inject.sell_shelf("gunworks:sniper_parts", "1-3", 0.03)
# 模组枪 (违禁品稀有好货, 恒 1)
inject.sell_shelf("gunworks:gw_pistol", 1, 0.03)
inject.sell_shelf("gunworks:gw_smg", 1, 0.03)
inject.sell_shelf("gunworks:gw_rifle", 1, 0.02)
inject.sell_shelf("gunworks:gw_autopistol", 1, 0.02)
# 原版枪械/配件/近战 (恒 1, 低概率; 民间军火质感, id 见 items_catalog.md)
inject.sell_shelf("handmade_pistol", 1, 0.04)    # 「巢火」紧凑型手枪
inject.sell_shelf("pipe_weapon", 1, 0.05)        # 铅管
inject.sell_shelf("combat_knife", 1, 0.04)       # 战斗匕首
inject.sell_shelf("revolver", 1, 0.03)           # 兰斯韦尔左轮手枪
inject.sell_shelf("shotgun", 1, 0.02)            # 「壁垒」双动式霰弹枪
inject.sell_shelf("silencer", 1, 0.03)           # 消音器
inject.sell_shelf("match_barrel", 1, 0.03)       # 比赛级枪管
inject.sell_shelf("mag_10mm", 1, 0.04)           # 10毫米弹匣

# ---- 原版掷骰池 (v1.10.0 inject.loot_pool) ----
inject.loot_pool("makeshiftWeapon", "gunworks:mcb_weapon_gun1", 0.03)
inject.loot_pool("material", "gunworks:pistol_parts", 0.04)
inject.loot_pool("material", "gunworks:smg_parts", 0.03)
inject.loot_pool("material", "gunworks:rifle_parts", 0.03)
inject.loot_pool("material", "gunworks:sniper_parts", 0.02)
inject.loot_pool("material", "gunworks:datacard_blank", 0.02)
