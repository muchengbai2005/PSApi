    smg = "gunworks:gw_smg", rifle = "gunworks:gw_rifle",
    bolt = "gunworks:gw_bolt_sniper", semi = "gunworks:gw_semi_sniper",
}

# 配方: 每槽位一个部件 id; null = 该武器不需要此槽 (槽位显示"不需要"并锁定)
