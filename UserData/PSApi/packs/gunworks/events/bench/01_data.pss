# 枪械组装台 — 静态配方数据 (模板包: 配方就是脚本里的表, 改表即改配方)
# 部件槽位固定: 0=机匣 1=枪管 2=手柄 3=枪机 4=弹匣 (面板结构恒定, 见 ui/gun_bench.psui 头部注释)
# v0.8.0: 零件槽 s5 (BENCH_PARTS_SLOT) — 每把枪消耗对应枪械零件×1, 隔夜随部件一起消耗
# 武器键是单词 (按钮 id = btn_w_<键>, bench_pick 按 split("_")[2] 解析)

var BENCH_SLOTS = ["s0", "s1", "s2", "s3", "s4"]
var BENCH_SLOT_NAMES = ["机匣", "枪管", "手柄", "枪机", "弹匣"]
var BENCH_PARTS_SLOT = "s5"
var BENCH_OUTPUT_SLOT = "sout"

var BENCH_WEAPONS = ["pistol", "autopistol", "smg", "rifle", "bolt", "semi"]
var BENCH_WEAPON_NAMES = {
    pistol = "手枪", autopistol = "自动手枪", smg = "冲锋枪",
    rifle = "步枪", bolt = "栓动狙击枪", semi = "半自动狙击枪",
}
# 武器一句话描述 (面板底部 lbl_desc 行: "<武器名> · <描述>")
