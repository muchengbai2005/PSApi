# 仿制证书 — 展示柜免记录 + 有效期衰减 (gunworks v0.7.0)
#
# 机制 (用户裁定):
#   - 一张管所有枪械 (desc 里的枪械字段是展示/设定, 不做逐枪匹配)
#   - 开张前放上展示柜 → 当天卖任何 WEAPON 类型物品不写治安档案
#     (WEAPON_TRAFFICKING 与 FENCING 同免; 只管当天新记录, 历史档案不动)
#   - 有效期 7 天 (v0.9.0, JSON useCount=7): 每晚所有证书 -1 (背包/后仓/展示柜都扣),
#     归零原生自动销毁。衰减按 id 扫描 + items.use 扣 1, 与次数上限无关 →
#     伪造师的 3-30 天随机款 / 引导员的 10 天见面礼 (items.give uses=N) 共用本逻辑, 无需改这里
#   - 展示柜防卖: 顶层 shop.block_sale 注册, 任何客户都不买证书
#     (否则放展示柜会被路人当商品买走)
#
# 技术路径: SecData.CheckSoldContraband Prefix (CrimeExemptPatch, 治安档案唯一写入口,
#   柜台议价+展示柜自动售货都走它) + PlayerStore.CanSellThisItem Prefix (禁售注册表)。

var PERMIT_ID = "gunworks:permit_forged"

shop.block_sale(PERMIT_ID)

# 开卷帘门: 展示柜里有证书 → 今天卖枪免记录 (开张后再放入的当天不生效, 与原版许可证同构)
on shop_opened():
    var found = false
    for it in shop.showcase_items():
        if it.id == PERMIT_ID:
            found = true
    crime.exempt_guns(found)
    if found:
        log.info("[gunworks] 仿制证书生效: 本日售卖枪械不留治安记录")

# 每天早上: 复位豁免开关 (重新等开张扫描) + 全场证书有效期 -1 (归零自动销毁)
on day_wake():
    crime.exempt_guns(false)
    for c in items.find_all(PERMIT_ID):
        items.use(c, 1)
    for it in shop.showcase_items():
        if it.id == PERMIT_ID:
            items.use(it, 1)
