# 物品分析仪 — 状态机与面板回调 (gunworks v0.6.0; 模式照 bench/02_bench.pss)
#
# 用法: 被测部件(s_item) + 空白数据卡(s_card) + 电池(s_batt) → 点开始分析 → 隔夜:
#   消耗被测部件与空白卡, 成品槽析出对应数据卡 (5 次, JSON useCount 定义)。
#   同类型部件析出同种卡 (长/中/短枪管 → 枪管数据卡)。
#
# 状态存 state: key = "analyzer:<uid>" → {analyzing, out_id, day}
# 隔夜遍历清单: state["analyzer:list"] = [uid...]。
# 耗电: 15 电/次 (s_batt 电池, 全有或全无; 不足则当晚不分析, 明晚重试)。

var ANALYZER_POWER = 15

# ---------- 状态存取 ----------

func analyzer_key(m):
    return "analyzer:{m.uid}"

func analyzer_st(m):
    var k = analyzer_key(m)
    if not state.has(k):
        state.set(k, {analyzing = false, out_id = "", day = 0})
    return state.get(k)

func analyzer_save(m, st):
    state.set(analyzer_key(m), st)
    var lst = state.get("analyzer:list", [])
    var uid = m.uid
    var found = false
    for u in lst:
        if u == uid:
            found = true
    if not found:
        push(lst, uid)
        state.set("analyzer:list", lst)

# ---------- 工具 ----------

# 部件 id → 析出的数据卡 id; 非部件 = null
func analyzer_card_for(id):
    if id == "gunworks:part_barrel_s" or id == "gunworks:part_barrel_m" or id == "gunworks:part_barrel_l":
        return "gunworks:datacard_barrel"
    if id == "gunworks:part_grip_s" or id == "gunworks:part_grip_l":
        return "gunworks:datacard_grip"
    if id == "gunworks:part_receiver_s" or id == "gunworks:part_receiver_l":
        return "gunworks:datacard_receiver"
    if id == "gunworks:part_bolt":
        return "gunworks:datacard_bolt"
    if id == "gunworks:part_mag":
        return "gunworks:datacard_mag"
    return null

# ---------- 刷新 (结构恒定: 只改文本/锁) ----------

func analyzer_refresh(m):
    var st = analyzer_st(m)
    ui.machine_lock(m, "s_item", st.analyzing)
    ui.machine_lock(m, "s_card", st.analyzing)
    if st.analyzing:
        ui.machine_set_text(m, "btn_analyze", "取消分析")
        ui.machine_set_text(m, "lbl_status", "分析中 (明早完成, 耗电 {ANALYZER_POWER})")
        return
    ui.machine_set_text(m, "btn_analyze", "开始分析")
    var part = ui.machine_slot_item(m, "s_item")
    var card = ui.machine_slot_item(m, "s_card")
    if part == null and card == null:
        ui.machine_set_text(m, "lbl_status", "放入被测部件与空白数据卡")
        return
    if part == null:
        ui.machine_set_text(m, "lbl_status", "还差: 被测部件")
        return
    if card == null:
        ui.machine_set_text(m, "lbl_status", "还差: 空白数据卡")
        return
    ui.machine_set_text(m, "lbl_status", "就绪: 隔夜析出数据卡 (耗电 {ANALYZER_POWER})")

# ---------- 面板回调 ----------

func analyzer_on_open(a):
    analyzer_refresh(a.machine)

func analyzer_changed(a):
    analyzer_refresh(a.machine)

func analyzer_output_changed(a):
    return

func analyzer_toggle(a):
    var m = a.machine
    var st = analyzer_st(m)
    if st.analyzing:
        # 取消: 解锁, 当晚不分析 (部件与卡保留在槽里)
        st.analyzing = false
        st.out_id = ""
        analyzer_save(m, st)
        analyzer_refresh(m)
        return
    var part = ui.machine_slot_item(m, "s_item")
    var card = ui.machine_slot_item(m, "s_card")
    if part == null or card == null:
        ui.machine_set_text(m, "lbl_status", "部件与空白数据卡都要放好才能开始")
        return
    if ui.machine_slot_item(m, "s_out") != null:
        ui.machine_set_text(m, "lbl_status", "先取走成品槽里的数据卡")
        return
    st.analyzing = true
    st.out_id = analyzer_card_for(part.id)
    st.day = time.day()
    analyzer_save(m, st)
    analyzer_refresh(m)

# ---------- 隔夜结算 ----------

on day_wake():
    var lst = state.get("analyzer:list", [])
    if len(lst) == 0:
        return
    var keep = []
    for uid in lst:
        var k = "analyzer:{uid}"
        if not state.has(k):
            continue
        var st = state.get(k)
        var alive = true
        if st.analyzing and time.day() > st.day:
            var m = ui.machine_find_uid(uid)
            if m == null:
                alive = false
            else:
                analyzer_overnight(m, st)
        if alive:
            push(keep, uid)
    state.set("analyzer:list", keep)

func analyzer_overnight(m, st):
    var batt = ui.machine_slot_item(m, "s_batt")
    var powered = false
    if batt != null:
        powered = items.power_draw(batt, ANALYZER_POWER)
    if not powered:
        ui.machine_set_text(m, "lbl_status", "电量不足, 今晚未能分析 (明晚重试)")
        st.day = time.day()
        analyzer_save(m, st)
        return
    # 成功: 先解锁再消耗 (与 bench_finish 同次序), 成品卡入输出槽
    ui.machine_lock(m, "s_item", false)
    var part = ui.machine_slot_item(m, "s_item")
    if part != null:
        items.consume(part)
    ui.machine_lock(m, "s_card", false)
    var card = ui.machine_slot_item(m, "s_card")
    if card != null:
        items.consume(card)
    if st.out_id != null and st.out_id != "":
        ui.machine_spawn(m, "s_out", st.out_id, 1)
    st.analyzing = false
    st.out_id = ""
    st.day = time.day()
    analyzer_save(m, st)
    analyzer_refresh(m)
