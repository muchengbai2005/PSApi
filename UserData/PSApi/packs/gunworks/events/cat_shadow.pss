# cat_shadow.pss — 黑市奸商「老猫·影」(gunworks v0.11.0)
#
# 移植自 example_hello/events/e4_demo.pss 的 pss_demo_fence 演示NPC (e4 侧已注释, 以此为准)。
# 对话原文一字不动; 货从演示用的 common_ore/bandage_item 换成 gunworks 模组物品池:
#   9 种枪械部件 + 4 种枪械零件 + 6 种数据卡 + 6 种组装枪 + 仿制证书 (不含机器),
#   外加原版 common_ore 压舱。rare_ore 暂缓 — 9-18 版本更新后存活性待 F11 全量 dump 确认
#   (即便失效也有 v1.11.0 运行时 id 校验兜底: 跳过+WARNING, 不崩)。
#
# 机制 (与 cells.pss 同套 npc.register):
#   schedule every_ndays(隔 2 天, 80% 概率) + 黑市加权池 npc.pool_add("bm", 权重 5) 并行生效;
#   can_spawn = 黑市声望非负才来;
#   sell_pool 加权不放回抽 6-10 种上架(每种 1-2 件, 与马洛夫/格雷的池化售卖同语义);
#   收购 = printed_gun(「解放者」打印手枪)。
# 与格雷(cell_fence)的 sell_pool 有意部分重叠 — 销赃商之间串货正常, 两人到货日不同。

# 生成谓词: 黑市声望非负才来(出错按不生成处理)
func can_cat_come():
    return rep.get("bm") >= 0

npc.register({
    id = "cat_shadow",
    name = "老猫·影",
    base_template = "shadyMerchant",
    faction = "black_market",
    intent = "sellnbuy",
    cash = 8000,
    price = {sell_single = 0.9, sell_bulk = 0.8, buy = 1.05},
    buying_ids = ["printed_gun"],
    sell_count = "6-10",
    sell_pool = [
        # 9 种枪械部件(组装台材料)
        "gunworks:part_receiver_s:4", "gunworks:part_receiver_l:3",
        "gunworks:part_barrel_s:4", "gunworks:part_barrel_m:4", "gunworks:part_barrel_l:3",
        "gunworks:part_grip_s:4", "gunworks:part_grip_l:3",
        "gunworks:part_bolt:4", "gunworks:part_mag:4",
        # 4 种枪械零件(打印机材料)
        "gunworks:pistol_parts:6", "gunworks:smg_parts:5",
        "gunworks:rifle_parts:4", "gunworks:sniper_parts:3",
        # 6 种数据卡(空白卡高权, 五种成品卡低权)
        "gunworks:datacard_blank:6", "gunworks:datacard_barrel:3", "gunworks:datacard_mag:3",
        "gunworks:datacard_receiver:3", "gunworks:datacard_bolt:3", "gunworks:datacard_grip:3",
        # 6 种组装枪(越大件权重越低)
        "gunworks:gw_pistol:4", "gunworks:gw_autopistol:3", "gunworks:gw_smg:3",
        "gunworks:gw_rifle:2", "gunworks:gw_bolt_sniper:2", "gunworks:gw_semi_sniper:2",
        # 仿制证书 + 原版矿石压舱
        "gunworks:permit_forged:3",
        "common_ore:5",
        # "rare_ore:2",  # 暂缓: 9-18 版本更新后存活性待 F11 全量 dump 确认
    ],
    dialogues = {
        main = ["看看货, 都是硬通货", "有些烫手的东西, 识货的来"],
        accept = ["痛快, 成交"],
        all_done = ["就这些了, 下次再来"],
        repeat = "又见面了, 老规矩",
    },
    schedule = {mode = "every_ndays", interval = 2, chance = 0.8},
    can_spawn = can_cat_come,
})

# 同时挂进黑市加权池(权重 ≈ 该池原版权重总和的 5%), 与调度并行生效
npc.pool_add("bm", "cat_shadow", 5.0)

# customer_generated: 原版/池/调度客户都会报; event.client 是客户句柄
on customer_generated():
    if event.id == "cat_shadow":
        log.info("[gunworks] 老猫·影到店: 现金 {event.client.cash}, 来源 {event.source}")
        event.client.say("main", "第 {time.rel_day()} 天的新货, 别问来路")
