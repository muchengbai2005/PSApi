# cells.pss — M2: 地下革命军 · 潜伏网络 14 细胞 NPC (手写脚本复刻)
# 迁移源: UserData/NpcManager/npc_json/revolutionaries.json (NpcManager v3.3.0 规则)
#
# v0.9.0: 全员英译名 (id 不变, 绰号保留为对话里的"道上叫法") + sprite 指派
#   (皮肤 key 全部取自 UserData/probe/ 实测集合, 无 maleRev/femaleRev 实测键 → 革命军成员
#    用伪装身份皮肤) + 长对话拆 texts 多段链 (寒暄→正题→细节) + 收购对话具体物品名 +
#   老枪/老鬼 sell_items 增加原版货 (配件弹药/赃物杂项, 概率阶梯)。
# v0.10.0: 马洛夫/格雷售卖池化 (sell_pool 加权不放回 + sell_count 种数, 其余细胞小贩不动)。
# v0.11.0 (需 Events v1.11.0+): 模组物品收购全覆盖 — 邓肯/裘德/马洛夫/格雷/瑞特 5 家加
#   buy_pool+buy_count(当日加权不放回掷 N 种, 与 buying_ids 必收合并), main 首候选末段用
#   {buy_list} 点名当日随机加收(必收项台词里已写死, 不复读); 瑞特 sell_items 移除解放步枪
#   (改由其收购 — buy/sell 同 id 不允许重叠); 切尼不收违禁品人设不动; CELL_REP 声望表不动。
#   分摊: 9部件→裘德 / 4零件+空白卡→邓肯 / 低档组装枪3→马洛夫 / 高档组装枪3→格雷 /
#   5成品数据卡→马洛夫buying_ids(原有) / 证书+解放步枪→瑞特。
#
# id 映射 (原 rev_cell_* → 本包 cell_*; 事件/trade_completed 的 npc_id 为裸 id):
#   rev_cell_gunsmith    → cell_gunsmith     马洛夫 (道上叫"老枪", 下层枪匠)
#   rev_cell_junker      → cell_junker       裘德 ("老周", 拾荒)
#   rev_cell_water       → cell_water        阿莱娜 ("阿兰", 水贩)
#   rev_cell_pilot       → cell_pilot        汉森 ("独眼老韩", 打捞船飞行员)
#   rev_cell_electrician → cell_electrician  邓肯 ("老邓", 电修铺)
#   rev_cell_medic       → cell_medic        玛妮 ("小满", 救护员)
#   rev_cell_tobacconist → cell_tobacconist  朱尔斯 ("九叔", 烟摊)
#   rev_cell_pharma      → cell_pharma       拜伦 ("白医生", 上层药商)
#   rev_cell_broke       → cell_broke        费尔南 ("冯先生", 没落贵族)
#   rev_cell_sec         → cell_sec          切尼 ("陈警官", 治安部钉子)
#   rev_cell_rat         → cell_rat          瑞特 ("黑市鼠")
#   rev_cell_fence       → cell_fence        格雷 ("老鬼", 销赃商)
#   rev_cell_contact     → cell_contact      诺曼 ("小北", 本部交通员)
#   rev_cell_cartel      → cell_cartel       墨菲 ("老墨", 卡特尔眼线)
#
# 字段映射:
#   keepPipelineBudget: true  → 脚本默认语义(工厂期 SetClientBudget, 生成管线吸引力加成照常叠加), 无需键
#   sellItems 常见层/特殊层   → 静态 sell_items, 每条 id:数量:概率 独立掷骰(分层概率逐字保留)
#   reputationBonus           → 文件尾 on trade_completed 脚本实现(玩家卖出清单物品 → 该客户阶层声望+)
#   isMultiBuyDisabled        → multi_buy_disabled (v1.1.0 新键)
#   noAcceptingContraband     → no_contraband (v1.1.0 新键)
#   v0.12.0: 收购+5% → price = {buy = 1.05}(旧 buy_price_mod 已废弃: 9-18 起该字段=玩家买单加价%)
# 物品 id: 解放轻步枪H1 = gunworks:mcb_weapon_gun1(本包 items/); 废土冲锋枪 = mymod_scrap_smg(原版);
#   其余全为原版裸 id。
# 未平移(无对应脚本 API, 见 README): global.lootTables(makeshiftWeapon 3% 解放步枪)、
#   global.dialogue(全局 acceptDeal/allDone 追加)。

# ============ 下层区 ============

# 马洛夫 —— 下层区枪匠, 网络的小军火库, 道上叫"老枪"
npc.register({
    id = "cell_gunsmith",
    name = "马洛夫",
    sprite = "maleScav5",
    base_template = "lower_level_gunsmith",
    faction = "lower",
    intent = "sellnbuy",
    budget = [1200, 400],
    price = {sell_single = 0.9, sell_bulk = 0.8, buy = 1.05},
    clear_buying = false,
    buying_ids = ["box_cutter", "kitchen_knife", "gun_part",
        "gunworks:datacard_barrel", "gunworks:datacard_mag", "gunworks:datacard_receiver",
        "gunworks:datacard_bolt", "gunworks:datacard_grip"],
    # v0.11.0: 低档组装枪翻新收购(当日 1 种; 其 sell_pool 不含这三种, 无重叠)
    buy_count = 1,
    buy_pool = ["gunworks:gw_pistol:3", "gunworks:gw_autopistol:2", "gunworks:gw_smg:2"],
    sell_items = [
        # 常见层(掩护商品, 静态必掷)
        "screwdriver:1:0.5", "stock:1:0.35",
    ],
    # v0.10.0: 售卖池化 — 加权不放回抽 4-6 种, 每种 1-2 件; 模组货高权重, 原版配件弹药低权重
    # (权重=抽选概率, 与 sell_items 的 chance 独立判定语义不同)
    sell_count = "4-6",
    sell_pool = [
        # 模组货(高权重): 零件/部件/数据卡/两台机器/模组枪
        "gunworks:pistol_parts:10", "gunworks:smg_parts:8", "gunworks:datacard_blank:8",
        "gunworks:part_printer:6", "gunworks:item_analyzer:6", "gunworks:part_barrel_s:6",
        "gunworks:part_grip_s:6", "gunworks:mcb_weapon_gun1:5", "printed_gun:5",
        "gunworks:part_mag:5", "gunworks:rifle_parts:5", "gunworks:sniper_parts:4",
        # 原版配件弹药(低权重, 枪匠本行货)
        "small_pistol_ammo:3", "heavy_pistol_ammo:3", "mag_22:3", "mag_10mm:2",
        "silencer_makeshift:2", "trigger_group:2", "match_barrel:1",
    ],
    dialogues = {
        main = [
            { texts = [
                "看看可以, 别乱摸。",
                "道上叫我老枪。本名马洛夫——名字不重要, 手艺重要。",
                "作坊长年收美工刀、厨刀、枪械零件, 组装台用剩的五种数据卡也收, 按行价加一成。今天还收: {{buy_list}}, 翻新得动, 价格好谈。",
            ]},
            { texts = [
                "柜台上的随便看, 柜台底下的只卖给熟人。",
                "想自己攒枪的话, 零件我这儿最齐——手枪件到狙击件, 每天到货看运气。",
                "弹药配件也到了几样: .22 SR弹药、10毫米弹药、两种弹匣、简易消音器、调校扳机组件。空数据卡? 找打印机去, 别找我。",
            ]},
            { texts = [
                "朱利安说你信得过。……他的话, 我姑且信一半。",
                "另一半, 看你柜台上敢摆什么。",
            ]},
        ],
        wrong_item = ["这玩意儿我用不上。……我要的是美工刀、厨刀、枪械零件, 还有五种用完的数据卡, 别的不收。"],
        right_item = ["好钢。……放心, 它不会闲着。"],
        accept = [
            "收下吧, 替我那些同伴谢谢你。",
            "成交。这枪保养得很好, 别问上一任主人。",
        ],
        all_done = ["柜台上没什么了。路上小心, 最近查得紧。"],
    },
    pools = [{name = "client", weight_pct = 5}, {name = "sell", weight_pct = 8}],
})

# 裘德 —— 垃圾堆里翻宝贝, 人称"老周"
npc.register({
    id = "cell_junker",
    name = "裘德",
    sprite = "maleScav2",
    base_template = "junker2",
    faction = "lower",
    intent = "sellnbuy",
    budget = [600, 300],
    price = {sell_single = 0.9, sell_bulk = 0.8, buy = 1.05},
    clear_buying = false,
    buying_ids = ["pipe_weapon", "combat_knife"],
    # v0.11.0: 枪械部件收购全覆盖(当日 2-3 种, 拾荒废品人设; sell_items 无部件, 无重叠)
    buy_count = "2-3",
    buy_pool = [
        "gunworks:part_receiver_s:4", "gunworks:part_receiver_l:3",
        "gunworks:part_barrel_s:4", "gunworks:part_barrel_m:4", "gunworks:part_barrel_l:3",
        "gunworks:part_grip_s:4", "gunworks:part_grip_l:3",
        "gunworks:part_bolt:4", "gunworks:part_mag:4",
    ],
    sell_items = [
        "glass_shard:4:0.5", "scrap_metal:3:0.6",
        "glass_shard_shiv:2:0.45",
    ],
    dialogues = {
        main = [
            { texts = [
                "垃圾堆里也能翻出宝贝, 你信不信?",
                "大伙儿叫老周, 叫裘德的没几个。……我高价收铅管和战斗匕首, 拣到了别卖别人。今天还收几样枪械部件: {{buy_list}}, 网里攒枪等着用。",
            ]},
            { texts = [
                "今天翻到大东西了。……不是这个, 是压箱底的。",
                "网里要给夜班岗添家伙, 铅管匕首都是急货, 等不到下周。",
            ]},
        ],
        wrong_item = ["不要这个。……铅管、战斗匕首, 有多少要多少, 别的免谈。"],
        right_item = ["嘿, 正好。弟兄们等这个等好久了。"],
        accept = ["成交。这刀子拿去, 别问哪来的。"],
        all_done = ["翻完了, 明天再去翻。"],
    },
    pools = [{name = "client", weight_pct = 3}],
})

# 阿莱娜 —— 水贩, 网络的耳目兼暗桩, 旧称"阿兰"
npc.register({
    id = "cell_water",
    name = "阿莱娜",
    sprite = "femaleLower1",
    base_template = "waterSeller",
    faction = "lower",
    intent = "sellnbuy",
    budget = [700, 300],
    price = {sell_single = 0.9, sell_bulk = 0.8, buy = 1.05},
    clear_buying = false,
    buying_ids = ["box_cutter"],
    sell_items = [
        "processed_juice:2:0.6", "energy_drink:2:0.5",
        "small_pistol_ammo:2:0.35",
    ],
    dialogues = {
        main = [
            { texts = [
                "买水吗? 今天的‘水’很干净。",
                "证件上写的是阿莱娜, 街上还叫阿兰的多。……另外收美工刀, 拆箱子用, 一把不少给钱。",
            ]},
            { texts = [
                "水是明面上的。你要是想看点别的, 我也有。",
                "耳朵也是这条街最灵的——谁家咳嗽一声, 河那边当天就知道。",
            ]},
        ],
        wrong_item = ["我这不收这个。……只收美工刀, 开箱快的那种, 别的不经手。"],
        right_item = ["嗯, 这刀拆箱子快。……也能拆别的。"],
        accept = ["水瓶底下压着的那个, 也给你了。"],
        all_done = ["水卖完了。……话也说完了。"],
    },
    pools = [{name = "client", weight_pct = 2.5}, {name = "sell", weight_pct = 4}],
})

# 汉森 —— 打捞船飞行员, 跑河上走私线, 绰号"独眼老韩"
npc.register({
    id = "cell_pilot",
    name = "汉森",
    sprite = "maleScav11",
    base_template = "salvagePilot",
    faction = "lower",
    intent = "sellnbuy",
    budget = [900, 400],
    price = {sell_single = 0.9, sell_bulk = 0.8, buy = 1.05},
    clear_buying = false,
    buying_ids = ["pipe_weapon", "glass_shard_shiv"],
    sell_items = [
        "hatchet:1:0.45", "crowbar:1:0.35",
        "stun_gun:1:0.15",
    ],
    dialogues = {
        main = [
            { texts = [
                "河上漂的东西, 什么都有。……包括不该漂的。",
                "老韩是绰号, 汉森是本名。船上收铅管和玻璃刀, 拿来就换钱。",
            ]},
            { texts = [
                "别看我只剩一只眼, 看货比谁都准。",
                "革命军的货七成走我的船。起风浪的时候, 你这店就是备用码头。",
            ]},
        ],
        wrong_item = ["船上没地方搁这个。……铅管、玻璃刀, 倒是能换钱。"],
        right_item = ["这东西在河那边值钱。……你知道河那边是谁。"],
        accept = ["拿好, 别在码头亮出来。"],
        all_done = ["起风了, 我得回船上。"],
    },
    pools = [{name = "client", weight_pct = 2.5}],
})

# 邓肯 —— 电器修理匠, 引信和遥控器的供应商, 人称"老邓"
npc.register({
    id = "cell_electrician",
    name = "邓肯",
    sprite = "maleEng3",
    base_template = "machine_scrapper",
    faction = "lower",
    intent = "sellnbuy",
    budget = [1000, 350],
    price = {sell_single = 0.9, sell_bulk = 0.8, buy = 1.05},
    clear_buying = false,
    buying_ids = ["wire", "common_electronic"],
    # v0.11.0: 枪械零件+空白数据卡收购(当日 1-2 种, 电工收零件/电子人设; sell_items 无重叠)
    buy_count = "1-2",
    buy_pool = [
        "gunworks:pistol_parts:4", "gunworks:smg_parts:4",
        "gunworks:rifle_parts:3", "gunworks:sniper_parts:2",
        "gunworks:datacard_blank:3",
    ],
    sell_items = [
        "energy_credit:2:0.6", "screwdriver:1:0.5", "wire_cutter:1:0.35",
        "stun_gun:1:0.12",
    ],
    dialogues = {
        main = [
            { texts = [
                "修电器? 还是买电池?",
                "老邓、邓肯, 随你叫。铺子收线缆和普通电子元件, 细铜丝最好。今天还收: {{buy_list}}, 价格公道。",
                "引信和遥控器的活儿也接。……这句你当没听见。",
            ]},
            { texts = [
                "我这双手, 能让哑巴收音机开口。……也能让别的东西闭嘴。",
                "你店里那几台机器要是闹脾气, 报我的名字, 零件算你半价。",
            ]},
        ],
        wrong_item = ["这个我修不了。……线缆、普通电子元件, 越多越好, 别的别占地方。"],
        right_item = ["好线。……缠起来能绕整个街区。"],
        accept = ["电池给你, 顺路。……‘那个东西’小心拿, 别摔。"],
        all_done = ["铺子要关门了。……电闸我拉了, 你懂的。"],
    },
    pools = [{name = "client", weight_pct = 3}],
})

# 玛妮 —— 民间救护员, 网络的战地军医, 熟人叫"小满"
npc.register({
    id = "cell_medic",
    name = "玛妮",
    sprite = "femaleSci2",
    base_template = "lowerLevelChemist",
    faction = "lower",
    intent = "sellnbuy",
    budget = [800, 300],
    price = {sell_single = 0.9, sell_bulk = 0.8, buy = 1.05},
    clear_buying = false,
    buying_ids = ["common_medical", "salve"],
    sell_items = [
        "bandage_item:3:0.7", "rubbing_alcohol:2:0.5", "hemostatic_bandage_item:1:0.4",
        "silencer:1:0.2",
    ],
    dialogues = {
        main = [
            { texts = [
                "止血、包扎、转运, 都找我。",
                "熟人叫小满, 登记册上写玛妮。……长期收医疗用品和南丁格尔软膏, 城那头用得上。",
            ]},
            { texts = [
                "救护车开不进的地方, 总得有人走进去。……你懂我意思。",
                "昨晚又抬出去两个。仗还没开打, 伤亡就已经开始了。",
            ]},
        ],
        wrong_item = ["这个救不了人。……医疗用品、南丁格尔软膏, 缺得很, 有就给我留着。"],
        right_item = ["太好了。……又能多撑过几个夜晚。"],
        accept = ["绷带拿好。……箱底那个‘器械’, 消过毒了。"],
        all_done = ["急救箱空了。……呼机响了, 我得走了。"],
    },
    pools = [{name = "client", weight_pct = 2.5}],
})

# 朱尔斯 —— 香烟摊主, 网络的情报站, 辈分到了都喊"九叔"
npc.register({
    id = "cell_tobacconist",
    name = "朱尔斯",
    sprite = "maleLower3",
    base_template = "lower_level_rare_merchant",
    faction = "lower",
    intent = "sellnbuy",
    budget = [600, 250],
    price = {sell_single = 0.9, sell_bulk = 0.8, buy = 1.05},
    clear_buying = false,
    buying_ids = ["cigarette_color"],
    sell_items = [
        "packet_red_cigarette:1:0.6", "processed_juice:2:0.5",
        "smoke_grenade:1:0.22", "pistol_switch:1:0.18",
    ],
    dialogues = {
        main = [
            { texts = [
                "来包烟?",
                "辈分到了都喊九叔, 本名叫朱尔斯。……海明威色卡我收, 出得起价, 你别说出去。",
            ]},
            { texts = [
                "烟是消费品, 情报是硬通货。……后半句你当没听见。",
                "谁的烟瘾忽然大了、谁忽然戒了, 都是消息。我这摊子, 卖的是耳朵。",
            ]},
        ],
        wrong_item = ["摊上不收这个。……只要海明威色卡, 别的免谈。"],
        right_item = ["好卡。……今晚的‘天气预报’就靠它了。"],
        accept = ["烟拿好。……夹层里的东西, 出了这条街再用。"],
        all_done = ["收摊了。……夜里风大, 早点回家。"],
    },
    pools = [{name = "client", weight_pct = 2.5}],
})

# ============ 上层区 ============

# 拜伦 —— 上层区药商, 网络的军医和资金通道, 人称"白医生"
npc.register({
    id = "cell_pharma",
    name = "拜伦",
    sprite = "maleUpper5",
    base_template = "shadyPharma",
    faction = "upper",
    intent = "sellnbuy",
    budget = [3000, 1000],
    price = {sell_single = 0.9, sell_bulk = 0.8, buy = 1.05},
    clear_buying = false,
    buying_ids = ["combat_knife", "skinning_knife"],
    sell_items = [
        "common_medical:2:0.6", "salve:1:0.45",
        "gunworks:mcb_weapon_gun1:1:0.2", "silencer:1:0.3",
    ],
    dialogues = {
        main = [
            { texts = [
                "最近‘外伤’的病人很多。",
                "都叫我白医生。拜伦——药学学位是真的, 处方是假的。",
                "我高价收锋利的‘手术器械’: 战斗匕首、剥皮刀, 越锋利越好。",
            ]},
            { texts = [
                "药能救人, 也能……算了, 当我没说。",
                "上层的捐款箱和下层的绷带, 中间都过我的手。这就是‘慈善’。",
            ]},
        ],
        wrong_item = ["这不是我的处方。……战斗匕首、剥皮刀, 锋利的‘器械’我才缺。"],
        right_item = ["好刀口。手术——我是说, 治疗, 会用上的。"],
        accept = [
            "这瓶‘药’拿好, 别一次用完。",
            "记住医嘱: 不到万不得已, 别打开。",
        ],
