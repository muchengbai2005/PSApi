# ==================== reputationBonus 平移 ====================
# 玩家把清单物品卖给对应客户(trade_completed direction=sell) → 该客户所处阶层声望+
# (NpcManager 规则 5: 原版「你获得了XX的声望」提示照常弹出)
var CELL_REP = {
    "cell_gunsmith"    = {rep = "ll",     items = {box_cutter = 2, kitchen_knife = 2, gun_part = 3,
        "gunworks:datacard_barrel" = 2, "gunworks:datacard_mag" = 2, "gunworks:datacard_receiver" = 2,
        "gunworks:datacard_bolt" = 2, "gunworks:datacard_grip" = 2}},
    "cell_junker"      = {rep = "ll",     items = {pipe_weapon = 3, combat_knife = 4}},
    "cell_water"       = {rep = "ll",     items = {box_cutter = 2}},
    "cell_pilot"       = {rep = "ll",     items = {pipe_weapon = 3, glass_shard_shiv = 2}},
    "cell_electrician" = {rep = "ll",     items = {wire = 2, common_electronic = 4}},
    "cell_medic"       = {rep = "ll",     items = {common_medical = 3, salve = 4}},
    "cell_tobacconist" = {rep = "ll",     items = {cigarette_color = 5}},
    "cell_pharma"      = {rep = "ul",     items = {combat_knife = 3, skinning_knife = 3}},
    "cell_broke"       = {rep = "ul",     items = {printed_gun = 4}},
    "cell_sec"         = {rep = "sec",    items = {gun_part = 5}},
    "cell_rat"         = {rep = "bm",     items = {pipe_weapon = 4, handmade_pistol = 5}},
    "cell_fence"       = {rep = "bm",     items = {glass_shard_shiv = 2, silencer_makeshift = 4}},
    "cell_contact"     = {rep = "rev",    items = {shotgun = 10, smg = 12, revolver = 10}},
    "cell_cartel"      = {rep = "cartel", items = {handmade_pistol = 6}},
}

on trade_completed():
    if event.direction != "sell":
        return
    var cfg = CELL_REP[event.npc_id]
    if cfg == null:
        return
    var pts = cfg.items[event.item_id]
    if pts == null:
        return
    rep.add(cfg.rep, pts)
    log.info("[gunworks] 细胞回报: {event.npc_name} 收下 {event.item_id}, {cfg.rep} 声望 +{pts}")
