# guide.pss — gunworks 内容包: 引导员朱利安剧情脚本版 (events/05 §7, E7 验收)
# 对照 NpcManager RevDeal.cs: 每周五(weekday==4)引导员来访, 三选项:
#   0 接受 → +200 定金, rev+10, 档案记 涉嫌通敌(200), 之后每周五津贴 100
#   1 我再想想 → 保持未决, 下周五再来; 连续推脱 3 周 → 再也不来 (用户定稿 2026-09-17,
#     语义同 RevDeal「考虑」但加了 3 次上限; RevDeal 原版是无限推脱)
#   2 举报 → sec+15, 再也不来
# 与 RevDeal 的其他差异(见交付报告): 周付在 day_wake 结算 (RevDeal 在对话 endAction);
# 档案 3 周重挂去重未平移 (crime 无查询 API)。
# v0.9.0: 老祝 → 朱利安 (sprite=mentor, 实测皮肤键); 接受分支追加见面礼
#   (组装台×1 + 10 天证书×1 + 随机 3~4 个部件, 幂等仅首次); 对话拆 texts 多段链;
#   周付叙旧扩写 (网络近况/费边/格雷)。
# v0.9.1: 见面礼改 items.give_counter(贴原版送礼路径, 货放门口柜台, 归玩家),
#   选项回复补柜台指引。

# 见面礼部件池 (9 种 part_*; rand(0,8) 取一件)
var GIFT_PARTS = [
    "gunworks:part_receiver_s", "gunworks:part_receiver_l",
    "gunworks:part_barrel_s", "gunworks:part_barrel_m", "gunworks:part_barrel_l",
    "gunworks:part_grip_s", "gunworks:part_grip_l",
    "gunworks:part_bolt", "gunworks:part_mag",
]

# 引导员(未决阶段): 三选项对话。选项点击只触发 dialogue_choice 事件, 效果全在本脚本
# v1.9.0: texts 语义改为多段顺序链 → 两个开场白是两个 dict 候选(随机抽一), choices/id 挂首候选
npc.register({
    id = "guide",
    name = "朱利安",
    sprite = "mentor",
    base_template = "radioactiveWasteCustomer",
    faction = "lower",
    intent = "DIALOGUE",
    dialogues = {
        main = [
            {
                id = "guide_intro",
                texts = [
                    "……老板，借一步说话。",
                    "我姓朱，朱利安，河对岸来的——道上还叫老祝。兄弟们想借你这店走点货：枪、刀、零件。",
                    "你只管中转，风险他们担，好处大家分。干不干？",
                ],
                choices = [
                    {label = "接受", desc = "收200定金+见面礼，革命军常来走货，档案记「涉嫌通敌(200)」", next = "好，爽快。这是200定金。见面礼已经给你放门口柜台上了：一台组装台、一张十天的证书，还有些零件，记得收。往后每周五，我来给你带100。——对了，档案上会多一条「涉嫌通敌」，查得紧的时候，自己掂量。"},
                    {label = "我再想想", desc = "下周五再来听信儿（连续推脱3周，他就死了这条心）", next = "……不急，这种事是得想想。下礼拜五，我再来听信儿。"},
                    {label = "举报", desc = "治安官会记你一功", next = "……好胆色，老板。这句话我会带到。"},
                ],
            },
            { texts = [
                "……又见面了，老板。",
                "还是那件事：帮兄弟们走货，你抽你的成。机会还在，就看你怎么选。",
            ]},
        ],
    },
    schedule = {mode = "manual"},
})

# 引导员(已接受阶段): 周五来访叙旧(津贴在 day_wake 已结算); 无 choices → auto_leave 说完就走
npc.register({
    id = "guide_pay",
    name = "朱利安",
    sprite = "mentor",
    base_template = "radioactiveWasteCustomer",
    faction = "lower",
    intent = "DIALOGUE",
    dialogues = {
        main = [
            { texts = [
                "……老规矩，这个礼拜的钱现在给你。",
                "货走得顺，兄弟们都记着你的好。",
            ]},
            { texts = [
                "……那边问起，就说你什么都没见过，这些钱拿着。",
                "对了，缺证书去找费边——雕版出身，手艺比真的还真。格雷那儿只有七天的基础款。",
            ]},
            { texts = [
                "轻轻的，收好了，已将到你账上了……街口最近加了岗，收货的兄弟会晚点到。",
                "马洛夫的零件照常到货。你的组装台别闲着，春天快到了。",
            ]},
        ],
    },
    schedule = {mode = "manual"},
})

# 每周五: 按阶段安排引导员 (npc.schedule = 挂起到开店建队时强制入队, put_first 排最前)
on day_wake():
    # M2: 革命军池权重×3 收敛 (对齐 RevDeal RevPoolMultiplier: 接受后 cell_* 全部池权重×3;
    # pool_scale 幂等, 每日重挂同权重, 换存档/重进对局后自动恢复)
    if state.get("stage", "pending") == "accepted":
        npc.pool_scale("cell_*", 3)
    if time.weekday() != 4:
        return
    var stage = state.get("stage", "pending")
    if stage == "pending":
        npc.schedule("gunworks:guide", {put_first = true})
        log.info("[gunworks] 周五: 引导员朱利安来访 (stage=pending)")
    elif stage == "accepted":
        player.add_cash(100)
        npc.schedule("gunworks:guide_pay", {put_first = true})
        log.info("[gunworks] 周五: 朱利安周付 +100 已入账, 来访叙旧 (stage=accepted)")

# 三选项结算 (event: {dialogue_id, choice, npc_id, npc_name, title})
on dialogue_choice():
    if event.dialogue_id != "gunworks:guide_intro":
        return
    if event.choice == 0:
        player.add_cash(200)
        rep.add("rev", 10)
        crime.commit("crime_gunworks_deal", 200, "涉嫌通敌")
        state.set("stage", "accepted")
        state.set("accept_rel_day", time.rel_day())
        npc.pool_scale("cell_*", 3)
        # 见面礼: 组装台×1 + 10 天证书×1 + 随机 3~4 个部件 (幂等, 仅首次; gifted 双保险)
        # v0.9.1: give_counter — 贴原版送礼路径, 货摆门口柜台归玩家 (不在对局时返回 false, 记日志兜底)
        if state.get("gifted", 0) == 0:
            state.set("gifted", 1)
            var ok = items.give_counter("gunworks:gw_bench", 1)
            ok = items.give_counter("gunworks:permit_forged", 1, 10) and ok
            var n = rand(3, 4)
            for i in range(n):
                ok = items.give_counter(GIFT_PARTS[rand(0, 8)], 1) and ok
            if ok:
                log.info("[gunworks] 见面礼已摆上门口柜台: 组装台×1 + 10天证书×1 + 部件×{n} (npc={event.npc_id})")
            else:
                log.warn("[gunworks] 见面礼摆柜不完整(不在对局或柜台满位), 已计入 gifted 不重复发 (npc={event.npc_id})")
        log.info("[gunworks] 玩家接受中间商交易: +200 定金, rev+10, 档案记 涉嫌通敌(200), 革命军池权重×3 (npc={event.npc_id})")
    elif event.choice == 1:
        # 我再想想: 保持未决下周五再来; 连续推脱 3 周 → 再也不来
        var n = state.get("defer_count", 0) + 1
        state.set("defer_count", n)
        if n >= 3:
            state.set("stage", "declined")
            log.info("[gunworks] 玩家连续推脱 {n} 周, 引导员死了这条心, 不再来访 (npc={event.npc_id})")
        else:
            log.info("[gunworks] 玩家再想想 (第 {n}/3 次推脱): 下周五再来 (npc={event.npc_id})")
    else:
        rep.add("sec", 15)
        state.set("stage", "reported")
        log.info("[gunworks] 玩家举报: sec+15, 引导员不再来访 (npc={event.npc_id})")

# E7 事件冒烟: 任何柜台成交打一行 (验收 trade_completed 用)
on trade_completed():
    log.info("[gunworks] trade_completed: {event.direction} {event.item_id} 金额={event.amount} 客户={event.npc_name}({event.npc_id})")
