# forger.pss — 伪造师费边 (gunworks v0.11.0): 仿制证件 + 额外好货
#
# 人设: 前市政证件科雕版师, 被裁后单干; 革命军的介绍信和治安部的通行证都会仿。
#   朱利安旧识, 格雷(老鬼)货架证书的上线; 治安部通缉栏有名但缺证据。
#   黑市阵营、DIALOGUE intent (纯对话, 不摆摊)。
#
# 售卖机制 (对话选项 + dialogue_choice, 同 guide.pss 模式; v0.11.0 改固定价双选项):
#   选项1「证件全套 300块」= 仿制证书(60% 3-9天 / 40% 10-30天, 加权掷天数) + 随机 3 件货;
#   选项2「只要货 150块」= 随机 3 件货(9 种部件 权3-4 / 5 种成品数据卡 权2 uses=5 /
#     空白卡 权2; 加权不放回, 拒绝采样实现 — 抽中已拿的重掷, 分布与不放回等价);
#   choices[].cond 谓词(需 Events v1.11.0)实现「钱不够不显示」:
#     现金 <300 隐藏全套、<150 只剩「再逛逛」。cond 隐藏会使运行时选项下标前移,
#     故结算按 运行时索引+现金 双重判定(见 dialogue_choice 注释)。
#   扣款 player.add_cash(-N); 证书衰减与天数无关(permit.pss 按 id 扫描 items.use 扣 1)。
#
# 调度: 每周一(weekday==0)掷本周行程, 随机 1-2 天出现 (npc.schedule 强制入队)。

# ---- 选项 cond 谓词: 钱不够不显示(在对话构建时求值) ----
func forge_full_ok():
    return player.cash() >= 300

func forge_parts_ok():
    return player.cash() >= 150

npc.register({
    id = "forger",
    name = "费边",
    sprite = "maleUpper8",
    base_template = "radioactiveWasteCustomer",
    faction = "black_market",
    intent = "DIALOGUE",
    dialogues = {
        main = [
            {
                id = "forger_intro",
                texts = [
                    "……证件科的雕版师, 认识吗? 不认识最好。",
                    "费边。以前给市政印通行证, 现在给‘需要的人’印许可证。要仿制证件吗?",
                    "三百块, 连证带货——天数看今天的油墨, 买定离手, 概不退换。",
                    "除了纸, 今天还有些额外的好东西。一百五三件, 不挑不退。",
                ],
                choices = [
                    {label = "证件全套（300块: 证书+三件货）", desc = "证书 3-30 天随机, 短的多长的少; 放展示柜, 当天卖枪不留档", next = "「验货吧。」费边把卡片和油布包一起从袖口推出来。", cond = forge_full_ok},
                    {label = "只要货（150块: 随机三件）", desc = "模组部件或数据卡, 不挑不退", next = "费边从柜台底下摸出个油布包。「别问来路。」", cond = forge_parts_ok},
                    {label = "再逛逛", desc = "今天先不买", next = "随你。纸比货长寿, 也比货危险——想通了再来。"},
                ],
            },
            { texts = [
                "治安部通缉栏第三行, 那张画像一点都不像我。",
                "生意照做。他们缺的不是证据, 是决心。",
            ]},
            { texts = [
                "格雷只管卖货, 我管纸。",
                "他柜台上那款只有七天。我这儿, 油墨够的话, 一个月也印得出来。",
            ]},
        ],
    },
    schedule = {mode = "manual"},
})

# 每周随机 1-2 天出现: 周一重掷行程 (state 存档, 换周自动更新)
on day_wake():
    var wd = time.weekday()
    if wd == 0:
        state.set("forger_n", rand(1, 2))
        state.set("forger_d1", rand(0, 6))
        state.set("forger_d2", rand(0, 6))
    var n = state.get("forger_n", 0)
    if wd == state.get("forger_d1", -1) or (n == 2 and wd == state.get("forger_d2", -1)):
        npc.schedule("gunworks:forger")
        log.info("[gunworks] 费边今天进城 (weekday={wd}, 本周行程 {state.get('forger_n', 0)} 天)")

# 随机 n 件「额外好货」: 加权不放回(拒绝采样)抽选 → 发放 → 记日志; 返回发放种数
func forge_give_goods(n):
    var pool = [
        {id = "gunworks:part_receiver_s", w = 4, uses = 0},
        {id = "gunworks:part_receiver_l", w = 3, uses = 0},
        {id = "gunworks:part_barrel_s",   w = 4, uses = 0},
        {id = "gunworks:part_barrel_m",   w = 4, uses = 0},
        {id = "gunworks:part_barrel_l",   w = 3, uses = 0},
        {id = "gunworks:part_grip_s",     w = 4, uses = 0},
        {id = "gunworks:part_grip_l",     w = 3, uses = 0},
        {id = "gunworks:part_bolt",       w = 4, uses = 0},
        {id = "gunworks:part_mag",        w = 4, uses = 0},
        {id = "gunworks:datacard_barrel",   w = 2, uses = 5},
        {id = "gunworks:datacard_mag",      w = 2, uses = 5},
        {id = "gunworks:datacard_receiver", w = 2, uses = 5},
        {id = "gunworks:datacard_bolt",     w = 2, uses = 5},
        {id = "gunworks:datacard_grip",     w = 2, uses = 5},
        {id = "gunworks:datacard_blank",    w = 2, uses = 0},
    ]
    var picked = []
    var guard = 0
    while len(picked) < n and guard < 200:
        guard = guard + 1
        var total = 0
        for e in pool:
            total = total + e.w
        var r = randf() * total
        var acc = 0
        var pick = pool[0]
        var chosen = false
        for e in pool:
            acc = acc + e.w
            if not chosen and r < acc:
                pick = e
                chosen = true
        var dup = false
        for p in picked:
            if p.id == pick.id:
                dup = true
        if not dup:
            push(picked, pick)
    var names = []
    for p in picked:
        if p.uses > 0:
            items.give(p.id, 1, p.uses)
        else:
            items.give(p.id, 1)
        var nm = items.name(p.id)
        if nm == null:
            nm = p.id
        push(names, nm)
    log.info("[gunworks] 费边配货: " + join(names, ", "))
    return len(picked)

# 结算: cond 隐藏会使运行时选项下标前移 —
#   现金 ≥300: [0=全套 1=只要货 2=逛逛]; 150≤现金<300: [0=只要货 1=逛逛]; 现金<150: [0=逛逛]
#   故 choice==0 须再按现金分全套/仅货, choice==1 只在现金 ≥300 时是「只要货」。
on dialogue_choice():
    if event.dialogue_id != "gunworks:forger_intro":
        return
    var cash = player.cash()
    if event.choice == 0 and cash >= 300:
        # 全套: 掷天数(60% 短期 3-9 天 / 40% 长期 10-30 天) → 扣 300 → 证书+三件货
        var days = 0
        if randf() < 0.6:
            days = rand(3, 9)
        else:
            days = rand(10, 30)
        player.add_cash(0 - 300)
        items.give("gunworks:permit_forged", 1, days)
        forge_give_goods(3)
        log.info("[gunworks] 费边: 售出全套 — {days} 天证书 + 3 件货, 收入 300 (npc={event.npc_id})")
        return
    if (event.choice == 0 and cash >= 150) or (event.choice == 1 and cash >= 300):
        player.add_cash(0 - 150)
        forge_give_goods(3)
        log.info("[gunworks] 费边: 售出 3 件货, 收入 150 (npc={event.npc_id})")
        return
    log.info("[gunworks] 费边: 玩家看了看, 没买 (npc={event.npc_id})")
