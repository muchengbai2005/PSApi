# 部件打印机 — 静态数据 (gunworks v0.6.0: 改表即改数值)
# 槽位固定 (面板结构恒定, 见 ui/part_printer.psui 头部注释):
#   s_melt = 2x6 熔化网格   s_batt_melt = 熔化电池   s_card = 数据卡
#   s_batt_print = 打印电池  s_out = 成品槽          btn_p0..p2 = 选择按钮(常驻)

var PRINTER_LIQUID_MAX = 30      # 液箱上限 (mB)
var PRINTER_MB_PER_INGOT = 3     # 1 金属锭 = 3 mB
var PRINTER_MELT_POWER = 2       # 熔 1 锭耗 2 电 (熔化电池)
var PRINTER_PRINT_POWER = 10     # 打印 1 件耗 10 电 (打印电池优先, 不足吃熔化电池)
var PRINTER_INGOT_ID = "metal_ingot"

# 数据卡 → 可选部件列表 (同类型部件共用一卡; 最多 3 项 = btn_p0..p2)
var PRINTER_CARD_OPTIONS = {
    "gunworks:datacard_barrel" = ["gunworks:part_barrel_s", "gunworks:part_barrel_m", "gunworks:part_barrel_l"],
    "gunworks:datacard_mag" = ["gunworks:part_mag"],
    "gunworks:datacard_receiver" = ["gunworks:part_receiver_s", "gunworks:part_receiver_l"],
    "gunworks:datacard_bolt" = ["gunworks:part_bolt"],
    "gunworks:datacard_grip" = ["gunworks:part_grip_s", "gunworks:part_grip_l"],
}

# 部件 → 打印液耗 (mB): 小件 1 / 中件 2 / 大件 3 / 特大 4
var PRINTER_PART_COST = {
    "gunworks:part_grip_s" = 1, "gunworks:part_mag" = 1,
    "gunworks:part_grip_l" = 2, "gunworks:part_barrel_s" = 2,
    "gunworks:part_barrel_m" = 3, "gunworks:part_receiver_s" = 3, "gunworks:part_bolt" = 3,
    "gunworks:part_barrel_l" = 4, "gunworks:part_receiver_l" = 4,
}

var PRINTER_PART_NAMES = {
    "gunworks:part_receiver_s" = "小机匣", "gunworks:part_receiver_l" = "大机匣",
    "gunworks:part_barrel_s" = "短枪管", "gunworks:part_barrel_m" = "中枪管", "gunworks:part_barrel_l" = "长枪管",
    "gunworks:part_grip_s" = "短手柄", "gunworks:part_grip_l" = "长手柄",
