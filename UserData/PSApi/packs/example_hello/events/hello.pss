# hello.pss — example_hello 的 PSScript 冒烟示例(覆盖 E1 语法面, 启动日志可见即内核生效)

const PACK = "example_hello"
var boot_count = 0

# 函数: 默认参数 / if-elif-else / for-continue / 数组成员 / 插值
func describe_stock(name, tags, discount = 0):
    var price = 120
    if discount > 0:
        price = price * (100 - discount) / 100
    var label = "{name}({len(tags)} 个标签)"
    for t in tags:
        if t == "hot":
            label += " [烫手]"
            continue
        label += " [" + t + "]"
    return "{label} 估价 {price}"

# 顶层语句立即执行: 字典 / while-break / 索引赋值 / 标准库
var stock = ["contraband", "hot", "clean"]
var deal = {"buyer": "老猫", "price": 500, "done": false}
var picked = []
var i = 0
while true:
    if i >= len(stock):
        break
    if stock[i] != "clean":
        push(picked, stock[i])
    i += 1

deal.price += 50
deal["done"] = true
boot_count += 1

log.info("hello.pss 已加载(第 {boot_count} 次): {describe_stock('赃物包', picked, 25)}")
log.info("deal: buyer={deal.buyer} price={deal['price']} done={deal.done} keys=[{join(keys(deal), ', ')}]")
log.info("range/in: {join(range(1, 8, 2), '|')} ; 'hot' in picked = {'hot' in picked}")
log.warn("format: " + format("{{}} 掷骰 d6 得 {{}}, 随机价 {{}}", PACK, rand(1, 6), floor(randf(0.5, 2.5) * 100)))

# 事件订阅: 进场景打印场景名(payload 是 string → event.value)
on scene_loaded():
    log.info("进入场景: {event.value} (scene_loaded handler 生效)")
    if event.value == "Shop":
        log.info("开店了, {PACK} 就绪")
