# customer_generated: 原版/池/调度客户都会报; event.client 是客户句柄
# (v0.4.1: 老猫专属分支随 NPC 迁往 gunworks; 这里只留通用日志演示)
on customer_generated():
    log.info("客户生成: {event.name}({event.id}) 来源 {event.source}")
