# u4_demo.pss — U4 演示: 图元槽位混合窗 (驱动 u4_printer.psui, 模组打印机原型)
# 放 2 个废金属进 grid_slot → 点"打一份报纸" → 消耗 2 废金属, 发 1 报纸进背包
# 关窗状态跟踪用 ui.is_open (不与 e6_demo.pss 的 on_window_closed 撞名)

# 槽内容变化 (拖入/取出/消耗都算): ev = {elem, value}; grid_slot 的 value = 句柄列表
func u4_feed_changed(ev):
    var n = len(ui.get_slot_items("feed"))
    ui.set_text("status_lbl", "材料: {n}/2 废金属")

func u4_print():
    var list = ui.get_slot_items("feed")
    var targets = []
    for it in list:
        if it.id == "scrap_metal":
            push(targets, it)
    if len(targets) < 2:
        ui.set_text("status_lbl", "材料不足: 需要 2 个废金属")
        log.info("[u4] 材料不足 ({len(targets)}/2)")
        return
    var ok1 = items.consume(targets[0])
    var ok2 = items.consume(targets[1])
    if ok1 and ok2:
        items.give("game:newspaper", 1)
        ui.set_text("status_lbl", "已打印 1 份报纸 (消耗 2 废金属)")
        log.info("[u4] 打印完成: 2 废金属 → 1 报纸")
    else:
        ui.set_text("status_lbl", "消耗失败 (ok={ok1}/{ok2})")
        log.info("[u4] consume 失败: {ok1}/{ok2}")

# 每天开店时确保面板开着 (is_open 幂等判断, 玩家关掉后次日再开)
on shop_opened():
    if not ui.is_open("u4_printer"):
        ui.open("example_hello:u4_printer")
        log.info("[u4] 模组打印机面板已打开 (图元树后端)")
