# inject.sell_shelf("example_hello:example_water", 2)
# inject.doctor("example_hello:example_water")
# inject.barter("example_hello:example_water", 2)

# 函数形式演示: 现算收购池(按客户现金返回)
func m1_dynamic_buy(client):
    if client.cash > 500:
        return ["example_hello:example_water"]
    return []

